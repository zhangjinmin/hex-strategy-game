import * as Phaser from 'phaser';
import { useGameStore } from '../../store/gameStore';
import { useAdminStore } from '../../store/adminStore';
import allianceShip2Url from '../../assets/ship/alliance_ship_2.png';
import empireShip2Url from '../../assets/ship/empire_ship_2.png';

/**
 * 自动扫描 assets/planet/ 下所有 .png 文件，提取星球 ID。
 * 放入新图片即可生效，无需修改代码。
 */
const planetImageModules = import.meta.glob('../../assets/planet/*.png', {
    eager: true,
    query: '?url',
    import: 'default',
});

const customPlanetIds: number[] = Object.keys(planetImageModules)
    .map(key => {
        const match = key.match(/\/(\d+)\.png$/);
        return match ? parseInt(match[1], 10) : null;
    })
    .filter((id): id is number => id !== null && !isNaN(id))
    .sort((a, b) => a - b);

export class StrategicScene extends Phaser.Scene {
    private store: any;
    private edgeGraphics!: Phaser.GameObjects.Graphics;
    private edgeFlowGraphics!: Phaser.GameObjects.Graphics; 
    private edges: { x1: number; y1: number; x2: number; y2: number; length: number; factionHint: number }[] = [];
    private edgeNextPulseTimes: number[] = [];
    private activePulses: { edgeIdx: number; progress: number; duration: number; color: number }[] = [];
    private readonly MAX_ACTIVE_PULSES = 10; 
    
    private bgStarFar!: Phaser.GameObjects.Graphics;
    private bgStarMid!: Phaser.GameObjects.Graphics;
    private bgStarNear!: Phaser.GameObjects.Graphics;
    
    private fleetContainer!: Phaser.GameObjects.Container;
    private fleetSprites: Map<number | string, Phaser.GameObjects.Container> = new Map();
    private nodeSprites: Map<number, Phaser.GameObjects.Image> = new Map();
    private constellationContainers: Phaser.GameObjects.Container[] = []; 
    private label_texts: Phaser.GameObjects.Text[] = []; 
    
    // ===== 右键菜单（v3.1 已删除，改为直接弹出面板）=====
    private fleetPanel: Phaser.GameObjects.Container | null = null;
    private contextAction: string = '';

    // ===== v3 新增：本地操作面板 =====
    private localOpPanel: Phaser.GameObjects.Container | null = null;
    private enemyOpPanel: Phaser.GameObjects.Container | null = null;
    private adminStore: any = null;
    
    // ===== 阶段六：Warp 系统视觉状态 =====
    private prevFleetStatuses: Map<number, string> = new Map();
    private prevPendingArrival: any = null;
    private etaMarkers: Map<number, Phaser.GameObjects.Container> = new Map();
    private prevNodeOwnership: Map<number, number> = new Map();
    private prevMapVersion: number = -1;
    
    // ================= 阶段一新增：节点动态归属权映射表 =================
    private nodeGraphicsMap: Map<number, Phaser.GameObjects.Arc> = new Map();

    // ===== 主题颜色系统 =====
    private themeColors: Record<string, number> = {};
    private isLightTheme: boolean = false;

    private refreshThemeColors() {
        this.isLightTheme = document.documentElement.dataset.theme === 'light';
        const c = this.themeColors;
        if (this.isLightTheme) {
            c.bg = 0xF0EBE0; c.surface = 0xFFFFFF; c.surfaceInset = 0xEDE7DC;
            c.text = 0x15110C; c.textMuted = 0x4E606F; c.textDisabled = 0xA4B0BC;
            c.border = 0xCCD3DB; c.borderStrong = 0x8A93A0;
            c.hover = 0xE8E4DD; c.hoverText = 0x1A1D21;
            c.alliance = 0x225BFF; c.empire = 0xE3193B; c.neutral = 0x6B7280;
            c.accentSortie = 0xE3193B; c.accentGarrison = 0x225BFF; c.accentHover = 0xE3193B;
            c.checkBg = 0xF0EBE0; c.checkActive = 0x225BFF; c.checkBorder = 0xCCD3DB;
            c.overlay = 0xFFFFFF; c.overlayAlpha = 0.9;
        } else {
            c.bg = 0x030308; c.surface = 0x0F172A; c.surfaceInset = 0x090B0E;
            c.text = 0xF8FAFC; c.textMuted = 0x94A3B8; c.textDisabled = 0x64748B;
            c.border = 0x334155; c.borderStrong = 0x475569;
            c.hover = 0x1E293B; c.hoverText = 0xFFFFFF;
            c.alliance = 0x3B82F6; c.empire = 0xEF4444; c.neutral = 0x6B7280;
            c.accentSortie = 0xEF4444; c.accentGarrison = 0x06B6D4; c.accentHover = 0xEF4444;
            c.checkBg = 0x1E293B; c.checkActive = 0x06B6D4; c.checkBorder = 0x475569;
            c.overlay = 0x000000; c.overlayAlpha = 0.85;
        }
    }

    private hexIntToStr(hex: number): string {
        const r = (hex >> 16) & 0xFF;
        const g = (hex >> 8) & 0xFF;
        const b = hex & 0xFF;
        return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
    }

    /**
     * 绘制拟态风格凸起面板：外阴影 + 主表面 + 顶部高光 + 底部暗边
     * @param g Graphics 对象
     * @param x 左上角 x
     * @param y 左上角 y
     * @param w 宽
     * @param h 高
     * @param radius 圆角
     */
    private drawNeoPanel(g: Phaser.GameObjects.Graphics, x: number, y: number, w: number, h: number, radius: number = 10) {
        const c = this.themeColors;
        // 1. 外阴影（多层叠加模拟模糊）
        g.fillStyle(0x000000, this.isLightTheme ? 0.10 : 0.55);
        g.fillRoundedRect(x + 2, y + 3, w, h, radius);
        g.fillStyle(0x000000, this.isLightTheme ? 0.06 : 0.35);
        g.fillRoundedRect(x + 1, y + 2, w, h, radius);
        // 2. 主表面
        g.fillStyle(c.surface, 0.98);
        g.fillRoundedRect(x, y, w, h, radius);
        // 3. 顶部高光线（亮色）
        const hi = this.isLightTheme ? 0xFFFFFF : 0x1E293B;
        g.lineStyle(1, hi, this.isLightTheme ? 0.9 : 0.5);
        g.beginPath();
        g.moveTo(x + radius, y + 0.5);
        g.lineTo(x + w - radius, y + 0.5);
        g.strokePath();
        // 4. 底部暗边
        const lo = this.isLightTheme ? 0xD4CFC4 : 0x05070A;
        g.lineStyle(1, lo, this.isLightTheme ? 0.6 : 0.7);
        g.beginPath();
        g.moveTo(x + radius, y + h - 0.5);
        g.lineTo(x + w - radius, y + h - 0.5);
        g.strokePath();
        // 5. 细边框
        g.lineStyle(1, c.border, this.isLightTheme ? 0.5 : 0.4);
        g.strokeRoundedRect(x, y, w, h, radius);
    }

    /**
     * 绘制拟态风格凹陷表面：用于列表背景、checkbox 未选中态
     */
    private drawNeoInset(g: Phaser.GameObjects.Graphics, x: number, y: number, w: number, h: number, radius: number = 6) {
        const c = this.themeColors;
        // 1. 凹陷表面（略深）
        g.fillStyle(c.surfaceInset, 0.95);
        g.fillRoundedRect(x, y, w, h, radius);
        // 2. 顶部内阴影（暗线）
        const topShadow = this.isLightTheme ? 0xC8C2B5 : 0x05070A;
        g.lineStyle(1, topShadow, this.isLightTheme ? 0.5 : 0.6);
        g.beginPath();
        g.moveTo(x + radius, y + 1);
        g.lineTo(x + w - radius, y + 1);
        g.strokePath();
        // 3. 底部内高光（亮线）
        const botHi = this.isLightTheme ? 0xFFFFFF : 0x1E293B;
        g.lineStyle(1, botHi, this.isLightTheme ? 0.7 : 0.3);
        g.beginPath();
        g.moveTo(x + radius, y + h - 1);
        g.lineTo(x + w - radius, y + h - 1);
        g.strokePath();
    }

    preload() {
        Object.entries(planetImageModules).forEach(([key, url]) => {
            const match = key.match(/\/(\d+)\.png$/);
            if (match) {
                const id = parseInt(match[1], 10);
                const textureKey = `planet_${id}`;
                this.load.image(textureKey, url as string);
            }
        });
        this.load.image('alliance_flag', '/src/assets/flag/alliance.png');
        this.load.image('empire_flag', '/src/assets/flag/empire.png');
        this.load.image('alliance_ship_2', allianceShip2Url);
        this.load.image('empire_ship_2', empireShip2Url);
    }

    create() {
        this.store = useGameStore();
        this.adminStore = useAdminStore();
        this.cameras.main.centerOn(0, 0); 
        this.cameras.main.setZoom(0.8);
        // 读取当前主题并设置背景色
        this.refreshThemeColors();
        this.cameras.main.setBackgroundColor(this.themeColors.bg); 

        this.createGlowTexture();
        this.createStarfieldBackground();

        this.edgeGraphics = this.add.graphics().setDepth(1).setBlendMode(Phaser.BlendModes.ADD);
        this.edgeFlowGraphics = this.add.graphics().setDepth(1).setBlendMode(Phaser.BlendModes.ADD);
        this.fleetContainer = this.add.container(0, 0).setDepth(5);

        // ================= 宏大叙事弯曲星带背景与公转 =================
        this.generateStarBeltTexture();

        const createStarBelt = (x: number, y: number, tint: number, scaleX: number, scaleY: number, orbitSpeed: number) => {
            const pivot = this.add.container(0, 0).setDepth(-20);
            const belt = this.add.image(x, y, 'star_belt_texture')
                .setBlendMode(Phaser.BlendModes.ADD) 
                .setTint(tint)
                .setAlpha(0.4) 
                .setScale(scaleX, scaleY);
            
            pivot.add(belt);
            
            this.tweens.add({
                targets: belt,
                alpha: 0.2,
                duration: Math.random() * 2000 + 6000, 
                yoyo: true,
                repeat: -1,
                ease: 'Sine.easeInOut'
            });

            this.time.addEvent({
                delay: 50,
                loop: true,
                callback: () => {
                    pivot.rotation += orbitSpeed;
                }
            });
        };

        createStarBelt(-1000, 0, 0x44aaff, 5.0, 3.5, 0.0005);
        createStarBelt(1000, 0, 0xff77aa, -5.0, 3.5, -0.0003);

        // ================= 阵营全息水印 =================
        const addWatermark = (key: string, x: number, y: number, customScale: number) => {
            const img = this.add.image(x, y, key)
                .setDepth(-10)
                .setAlpha(0.019)
                .setBlendMode(Phaser.BlendModes.ADD);
            img.setScale(customScale); 
            return img;
        };

        const allianceWatermark = addWatermark('alliance_flag', -1500, 500, 1.0); 
        const empireWatermark = addWatermark('empire_flag', 1200, 200, 2.5);     

        this.time.addEvent({
            delay: 50,
            loop: true,
            callback: () => {
                allianceWatermark.rotation -= 0.0003;
                empireWatermark.rotation += 0.0003;
            }
        });

        this.input.on('pointermove', (pointer: Phaser.Input.Pointer) => {
            if (pointer.isDown && pointer.button === 0) { 
                this.cameras.main.scrollX -= (pointer.x - pointer.prevPosition.x) / this.cameras.main.zoom;
                this.cameras.main.scrollY -= (pointer.y - pointer.prevPosition.y) / this.cameras.main.zoom;
            }
        });

        // 禁用浏览器右键菜单
        this.input.mouse?.disableContextMenu();

        // 全局右键 + 关闭菜单
        this.input.on('pointerdown', (pointer: Phaser.Input.Pointer) => {
            // 右键
            if (pointer.button === 2) {
                const hitNode = this.hitTestNodeAt(pointer.worldX, pointer.worldY);
                if (hitNode) {
                    this.showNodeRightMenu(pointer.worldX, pointer.worldY, hitNode);
                }
                return;
            }
            // 左键：点击面板外关闭面板
            if (this.localOpPanel?.active) {
                if (!this.isPointerInModal(pointer, this.localOpPanel)) {
                    this.hideLocalOpPanel();
                }
            }
            if (this.enemyOpPanel?.active) {
                if (!this.isPointerInModal(pointer, this.enemyOpPanel)) {
                    this.hideEnemyOpPanel();
                }
            }
        });

        this.input.on('wheel', (pointer: any, gameObjects: any, deltaX: number, deltaY: number) => {
            this.cameras.main.setZoom(Phaser.Math.Clamp(this.cameras.main.zoom - deltaY * 0.001, 0.3, 2.0));
        });

        this.renderStaticTopology();
    }

    // 获取阵营标准色 (用于领土环和舰队)
    private getFactionColor(factionId: number): number {
        if (factionId === 1) return 0x44aaff; 
        if (factionId === 2) return 0xff77aa; 
        return 0x888888; 
    }

    update() {
        if (!this.store) return;

        // 检测战略地图版本变化（新游戏/读档后 initStrategicMap 重新执行）
        const currVersion = (this.store as any).strategicMapVersion?.value ?? (this.store as any).strategicMapVersion ?? 0;
        if (currVersion !== this.prevMapVersion && this.prevMapVersion !== -1) {
            // 版本变化 → 清空所有动态精灵，强制重建
            this.fleetSprites.forEach(container => container.destroy());
            this.fleetSprites.clear();
            this.etaMarkers.forEach(container => container.destroy());
            this.etaMarkers.clear();
            this.prevFleetStatuses.clear();
            this.prevNodeOwnership.clear();
            this.prevPendingArrival = null;
        }
        this.prevMapVersion = currVersion;

        try {

        // 主题变化检测：每帧检查 data-theme，变化时更新背景色 + 关闭已打开面板强制重绘
        const currTheme = document.documentElement.dataset.theme === 'light';
        if (currTheme !== this.isLightTheme) {
            this.refreshThemeColors();
            this.cameras.main.setBackgroundColor(this.themeColors.bg);
            this.hideFleetPanel();
            this.hideLocalOpPanel();
            this.hideEnemyOpPanel();
        }

        // 1. 同步星座网格自转
        this.constellationContainers.forEach(container => {
            container.rotation += (container as any).rotSpeed;
        });

        // 2. 标签抗缩放
        const zoom = this.cameras.main.zoom;
        this.label_texts.forEach(text => {
            text.setScale(1 / zoom);
        });

        // 3. 视差背景漂移
        if (this.bgStarNear) {
            this.bgStarNear.x = this.cameras.main.scrollX * -0.02;
            this.bgStarNear.y = this.cameras.main.scrollY * -0.02;
        }
        if (this.bgStarMid) {
            this.bgStarMid.x = this.cameras.main.scrollX * -0.01;
            this.bgStarMid.y = this.cameras.main.scrollY * -0.01;
        }

        // 4. ================= 阶段一：同步节点归属权颜色 =================
        const rawNodes = this.store.strategicNodes;
        const nodes = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
        
        nodes.forEach((nodeData: any) => {
            const territoryRing = this.nodeGraphicsMap.get(nodeData.id);
            if (territoryRing) {
                // 根据当前 ownerFactionId 实时改变外环颜色（保持极淡，不喧宾夺主）
                territoryRing.setStrokeStyle(0, this.getFactionColor(nodeData.ownerFactionId), 0.2);
            }
        });

        this.updateEdgeFlow();
        this.updateDynamicEntities();

        // 舰队面板 / 本地操作面板 / 敌方操作面板对抗缩放：zoom 变化时同步 scale
        if (this.fleetPanel) {
            this.fleetPanel.setScale(1 / this.cameras.main.zoom);
        }
        if (this.localOpPanel) {
            this.localOpPanel.setScale(1 / this.cameras.main.zoom);
        }
        if (this.enemyOpPanel) {
            this.enemyOpPanel.setScale(1 / this.cameras.main.zoom);
        }

        } catch (err) {
            console.error('[StrategicScene.update] crash prevented:', err);
            // 不清空 store，让下一帧继续尝试恢复
        }
    }

    // ================= 阶段六：舰队视觉（IDLE 驻留 + WARPING ETA 标记 + 跃迁 VFX）=================
    private updateDynamicEntities() {
        const rawFleets = this.store.strategicFleets;
        const fleets: any[] = rawFleets?.value !== undefined ? rawFleets.value : (rawFleets || []);
        const rawNodes = this.store.strategicNodes;
        const nodes: any[] = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
        const time = this.time.now;
        const selectedId = this.store.selectedFleetId;
        const aliveKeys = new Set<string>();

        // ---- 分组：IDLE / WARPING / 其他 ----
        const idleByNode = new Map<number, any[]>();
        const warpingFleets: any[] = [];
        fleets.forEach((f: any) => {
            const totalShips = (f.composition?.battleships || 0) + (f.composition?.cruisers || 0) + (f.composition?.destroyers || 0);
            if (f.status === 'warping') {
                warpingFleets.push(f);
            } else if (totalShips > 0) {
                const nid = f.currentNodeId;
                if (nid >= 0) {
                    if (!idleByNode.has(nid)) idleByNode.set(nid, []);
                    idleByNode.get(nid)!.push(f);
                }
            }
        });

        // ---- 检测跃迁出发 VFX ----
        fleets.forEach((fleet: any) => {
            const prevStatus = this.prevFleetStatuses.get(fleet.id);
            if (prevStatus && prevStatus !== 'warping' && fleet.status === 'warping') {
                this.playWarpOutVFX(fleet, nodes);
            }
        });

        // ---- 驻留舰队：星球上空 ----
        const renderedNodes = new Set<number>();
        idleByNode.forEach((nodeFleets, nodeId) => {
            const node = nodes.find((n: any) => n.id === nodeId);
            if (!node) return;
            renderedNodes.add(nodeId);
            const texKey = nodeFleets[0].factionId === 1 ? 'alliance_ship_2' : 'empire_ship_2';
            const key = `garrison_${nodeId}`;
            aliveKeys.add(key);

            let container = this.fleetSprites.get(key);
            if (!container) {
                container = this.add.container(node.x, node.y - 50).setDepth(9);
                const flagship = this.add.image(0, 0, texKey).setDisplaySize(52, 22);
                const escorts: Phaser.GameObjects.Image[] = [];
                for (let i = 0; i < 3; i++) {
                    escorts.push(this.add.image(0, 0, texKey).setDisplaySize(23, 10).setAlpha(0.55 + i * 0.08));
                }
                container.add([flagship, ...escorts]);
                this.fleetContainer.add(container);
                this.fleetSprites.set(key, container);
                flagship.setInteractive();
                flagship.on('pointerdown', () => {
                    const first = nodeFleets[0];
                    if (first) this.store.selectedFleetId = this.store.selectedFleetId === first.id ? null : first.id;
                });
            }

            container.setPosition(node.x, node.y - 50);
            const flagship = container.list?.[0] as Phaser.GameObjects.Image;
            if (flagship) {
                // 原始图像已按阵营正确朝向：同盟朝右，帝国朝左
                // 无需翻转
            }

            for (let i = 1; i <= 3 && i < container.list.length; i++) {
                const esc = container.list[i] as Phaser.GameObjects.Image;
                if (esc) {
                    esc.setAlpha(0.5 + Math.sin(time * 0.001 + i) * 0.1);
                }
                const baseX = -36;
                const baseY = (i - 2) * 15;
                esc.x = baseX + Math.sin(time * 0.0004 + i * 2.3) * 2;
                esc.y = baseY + Math.cos(time * 0.0005 + i * 1.7) * 2;
            }
        });

        // ---- WARPING 舰队：ETA 浮动标记 ----
        warpingFleets.forEach((fleet: any) => {
            const targetNodeId = fleet.warpTargetId;
            if (targetNodeId == null) return;
            const targetNode = nodes.find((n: any) => n.id === targetNodeId);
            if (!targetNode) return;
            const markerKey = `eta_${fleet.id}`;
            aliveKeys.add(markerKey);

            let markerContainer = this.etaMarkers.get(fleet.id);
            if (!markerContainer) {
                markerContainer = this.add.container(targetNode.x, targetNode.y - 70).setDepth(10).setAlpha(0.85);
                const etaBg = this.add.graphics();
                this.drawNeoPanel(etaBg, -60, -14, 120, 28, 6);
                const label = this.add.text(0, 0, '', {
                    fontSize: '10px', color: this.hexIntToStr(this.themeColors.alliance), fontFamily: 'sans-serif',
                    stroke: this.hexIntToStr(this.themeColors.surface), strokeThickness: 2,
                }).setOrigin(0.5);
                markerContainer.add([etaBg, label]);
                markerContainer.setName('etaMarker');
                this.etaMarkers.set(fleet.id, markerContainer);
            }

            markerContainer.setPosition(targetNode.x, targetNode.y - 70);

            const allAdms = this.store.allAdmirals?.value || this.store.allAdmirals || [];
            const adm = allAdms.find((a: any) => a.id === fleet.commanderId);
            const admName = adm?.name || '未知';
            const ticksPerDay = 10;
            const now = (this.store as any).totalTicks ?? 0;
            const etaDay = fleet.etaDay != null ? Math.ceil(fleet.etaDay / ticksPerDay) : '?';
            const remaining = fleet.etaDay != null ? Math.max(0, Math.ceil((fleet.etaDay - now) / ticksPerDay)) : '?';
            const label = markerContainer.list?.[1] as Phaser.GameObjects.Text | undefined;
            if (label) {
                label.setText(`${admName}\nETA: Day${etaDay} · 剩余${remaining}日`);
            }

            // 与镜头缩放对抗
            markerContainer.setScale(1 / this.cameras.main.zoom);
        });

        // ---- 清理过期精灵与标记 ----
        this.fleetSprites.forEach((container, key) => {
            if (!aliveKeys.has(String(key))) {
                container.destroy(); this.fleetSprites.delete(key);
            }
        });
        this.etaMarkers.forEach((container, fleetId) => {
            if (!aliveKeys.has(`eta_${fleetId}`)) {
                container.destroy(); this.etaMarkers.delete(fleetId);
            }
        });

        // ---- 保存状态快照用于下次帧检测变化 ----
        fleets.forEach((f: any) => {
            this.prevFleetStatuses.set(f.id, f.status);
        });

        // ---- 跃迁到达 VFX ----
        const currPendingArrival = this.store.pendingArrival?.value ?? this.store.pendingArrival;
        if (currPendingArrival && this.prevPendingArrival !== currPendingArrival) {
            this.playWarpInVFX(currPendingArrival, nodes);
        }
        this.prevPendingArrival = currPendingArrival;

        // ---- 行星占领：白色闪烁 → 目标颜色 =====
        nodes.forEach((node: any) => {
            const prevOwner = this.prevNodeOwnership.get(node.id);
            if (prevOwner !== undefined && prevOwner !== node.ownerFactionId) {
                const sprite = this.nodeSprites.get(node.id);
                // 防御：Phaser GameObject 上才有 setTint/setFillStyle；Phaser Graphics 没有 setTint
                if (sprite && sprite.active && typeof (sprite as any).setTint === 'function') {
                    const targetTint = node.ownerFactionId === 1 ? 0x4a90d9 : node.ownerFactionId === 2 ? 0xd94a4a : 0xdddddd;
                    // 先闪白 150ms，再过渡到目标色
                    (sprite as any).setTint(0xffffff);
                    this.tweens.add({
                        targets: sprite,
                        tintValue: targetTint,
                        duration: 650, delay: 150,
                        ease: 'Quad.easeInOut',
                    });
                }
            }
            this.prevNodeOwnership.set(node.id, node.ownerFactionId);
        });

        // ---- ROUT 溃败：自动撤退跃迁 VFX ----
        const currPendingPostBattle = this.store.pendingPostBattle?.value ?? this.store.pendingPostBattle;
        if (currPendingPostBattle?.result?.outcome === 'rout') {
            const fleet = fleets.find((f: any) => f.id === currPendingPostBattle.fleetId);
            if (fleet) {
                this.playWarpOutVFX(fleet, nodes);
            }
        }
    }

    /** 跃迁出发 VFX：舰船缩小 + 淡出 + 粒子尾迹 + 白色光环扩散 */
    private playWarpOutVFX(fleet: any, nodes: any[]) {
        try {
        const originNodeId = fleet.warpOriginId ?? fleet.prevNodeId;
        if (originNodeId == null || originNodeId < 0) return;
        const node = nodes.find((n: any) => n.id === originNodeId);
        if (!node) return;

        const texKey = fleet.factionId === 1 ? 'alliance_ship_2' : 'empire_ship_2';
        const ship = this.add.image(node.x, node.y - 50, texKey).setDisplaySize(52, 22).setDepth(15).setFlipX(true);
        const ring = this.add.circle(node.x, node.y, 8, 0xffffff, 0.7)
            .setDepth(14).setBlendMode(Phaser.BlendModes.ADD).setStrokeStyle(2, 0xbfdbfe);

        // 粒子尾迹
        const trailParticles: Phaser.GameObjects.Ellipse[] = [];
        for (let i = 0; i < 5; i++) {
            const trail = this.add.ellipse(node.x, node.y - 50, 3 + i, 3 + i, 0x93c5fd, 0.6 - i * 0.1)
                .setDepth(13).setBlendMode(Phaser.BlendModes.ADD);
            trailParticles.push(trail);
            this.tweens.add({
                targets: trail,
                x: node.x + (Math.random() - 0.5) * 40,
                y: node.y - 50 - (i + 1) * 18,
                alpha: 0, scaleX: 0.1, scaleY: 0.1,
                duration: 500 + i * 80, delay: i * 60,
                ease: 'Quad.easeOut',
                onComplete: () => trail.destroy(),
            });
        }

        // 舰船缩小 + 淡出
        this.tweens.add({
            targets: ship,
            scaleX: 0.1, scaleY: 0.1, alpha: 0,
            duration: 600, ease: 'Quad.easeIn',
            onComplete: () => ship.destroy(),
        });

        // 光环向外扩散
        this.tweens.add({
            targets: ring,
            scaleX: 4, scaleY: 4, alpha: 0,
            duration: 800, ease: 'Quad.easeOut',
            onComplete: () => ring.destroy(),
        });
        } catch (err) {
            console.error('[playWarpOutVFX] VFX error:', err);
        }
    }

    /** 跃迁到达 VFX：光粒子汇聚 + 舰船淡入放大 + 镜头拉近 */
    private playWarpInVFX(arrivalCtx: any, nodes: any[]) {
        try {
        const targetNode = nodes.find((n: any) => n.id === arrivalCtx.targetNodeId);
        if (!targetNode) return;

        // 镜头平滑移到事件星球（使用 scrollTo 而非 pan 避免锁定）
        const cam = this.cameras.main;
        const targetScrollX = targetNode.x - cam.width / 2 / cam.zoom;
        const targetScrollY = targetNode.y - cam.height / 2 / cam.zoom;
        const fromSX = cam.scrollX, fromSY = cam.scrollY;
        this.tweens.addCounter({
            from: 0, to: 1, duration: 1800, ease: 'Quad.easeInOut',
            onUpdate: (tween: Phaser.Tweens.Tween) => {
                const p = tween.getValue() ?? 0;
                cam.scrollX = fromSX + (targetScrollX - fromSX) * p;
                cam.scrollY = fromSY + (targetScrollY - fromSY) * p;
            },
        });

        // 事件星球高亮 — 六边形扫描环 + 中心光点
        const allianceColor = 0x3b82f6;
        const empireColor = 0xef4444;
        const nodeColor = targetNode.ownerFactionId !== 1 ? empireColor : allianceColor;
        
        // 内环：发光核心
        const core = this.add.circle(targetNode.x, targetNode.y, 8, nodeColor, 0.3)
            .setDepth(12).setBlendMode(Phaser.BlendModes.ADD);
        this.tweens.add({
            targets: core, alpha: 0, scaleX: 2.5, scaleY: 2.5,
            duration: 1200, ease: 'Quad.easeOut',
            onComplete: () => core.destroy(),
        });
        
        // 外环：六边形扫描线
        const hex = this.add.graphics().setDepth(11);
        const hexRadius = 40;
        for (let k = 0; k < 3; k++) {
            this.tweens.addCounter({
                from: 0, to: 1, delay: k * 400, duration: 1200,
                ease: 'Quad.easeInOut',
                onUpdate: (tween: Phaser.Tweens.Tween) => {
                    hex.clear();
                    const prog = tween.getValue() ?? 0;
                    const r = hexRadius * (0.6 + 0.4 * prog);
                    const alpha = 1 - prog;
                    hex.lineStyle(1.5, nodeColor, alpha * 0.8);
                    const pts = [];
                    for (let i = 0; i < 7; i++) {
                        const a = (i / 6) * Math.PI * 2 - Math.PI / 2 + prog * Math.PI;
                        pts.push({ x: targetNode.x + Math.cos(a) * r, y: targetNode.y + Math.sin(a) * r });
                    }
                    hex.beginPath();
                    hex.moveTo(pts[0].x, pts[0].y);
                    for (let i = 1; i < 7; i++) hex.lineTo(pts[i].x, pts[i].y);
                    hex.strokePath();
                },
                onComplete: () => { if (k === 2) { this.tweens.add({ targets: hex, alpha: 0, duration: 400, onComplete: () => hex.destroy() }); } },
            });
        }

        // 光粒子汇聚
        const particles: Phaser.GameObjects.Ellipse[] = [];
        for (let i = 0; i < 10; i++) {
            const angle = (i / 10) * Math.PI * 2;
            const startDist = 80 + Math.random() * 50;
            const px = targetNode.x + Math.cos(angle) * startDist;
            const py = targetNode.y + Math.sin(angle) * startDist;
            const particle = this.add.ellipse(px, py, 4, 4, 0xa5d8ff, 0.9)
                .setDepth(15).setBlendMode(Phaser.BlendModes.ADD);
            particles.push(particle);

            this.tweens.add({
                targets: particle,
                x: targetNode.x, y: targetNode.y,
                alpha: 0, scaleX: 0.3, scaleY: 0.3,
                duration: 500 + i * 50,
                ease: 'Quad.easeIn',
                onComplete: () => particle.destroy(),
            });
        }

        // 舰船淡入 + 放大（用 displaySize 避免原始纹理尺寸爆炸）
        const fleet = this.store.strategicFleets?.value?.find((f: any) => f.id === arrivalCtx.fleetId)
            || this.store.strategicFleets?.find((f: any) => f.id === arrivalCtx.fleetId);
        const texKey = fleet?.factionId === 1 ? 'alliance_ship_2' : 'empire_ship_2';
        const ship = this.add.image(targetNode.x, targetNode.y - 50, texKey)
            .setDisplaySize(10, 5).setDepth(16).setFlipX(true).setAlpha(0);

        this.tweens.add({
            targets: ship,
            displayWidth: 44, displayHeight: 24,
            alpha: 1,
            duration: 700, delay: 500,
            ease: 'Quad.easeOut',
            onComplete: () => {
                this.tweens.add({
                    targets: ship,
                    alpha: 0, displayWidth: 50, displayHeight: 27,
                    duration: 300, delay: 800,
                    onComplete: () => ship.destroy(),
                });
            },
        });
        } catch (err) {
            console.error('[playWarpInVFX] VFX error:', err);
        }
    }

    private updateEdgeFlow() {
        const g = this.edgeFlowGraphics;
        const now = this.time.now;

        if (this.activePulses.length < this.MAX_ACTIVE_PULSES) {
            for (let idx = 0; idx < this.edges.length; idx++) {
                if (now >= this.edgeNextPulseTimes[idx]) {
                    const e = this.edges[idx];
                    let color: number;
                    if (e.factionHint === 1) color = 0xa5d8ff;
                    else if (e.factionHint === 2) color = 0xfecaca;
                    else if (e.factionHint === 0) color = 0xfef08a;
                    else color = 0xcffafe;

                    const duration = 1000 + ((idx * 97) % 800);

                    this.activePulses.push({ edgeIdx: idx, progress: 0, duration, color });
                    this.edgeNextPulseTimes[idx] = now + 6000 + ((idx * 311) % 9000);
                    break;
                }
            }
        }

        g.clear();
        for (let i = this.activePulses.length - 1; i >= 0; i--) {
            const pulse = this.activePulses[i];
            pulse.progress += (this.game.loop.delta / pulse.duration);

            if (pulse.progress >= 1) {
                this.activePulses.splice(i, 1);
                continue;
            }

            const e = this.edges[pulse.edgeIdx];
            const p = pulse.progress;

            let lifeAlpha: number;
            if (p < 0.04) lifeAlpha = p / 0.04;
            else if (p > 0.88) lifeAlpha = 1 - ((p - 0.88) / 0.12);
            else lifeAlpha = 1.0;

            const tailLen = 0.20;
            const segments = 12;

            for (let s = segments - 1; s >= 0; s--) {
                const segStartT = Math.max(0, p - (s / segments) * tailLen);
                const segEndT = Math.max(0, p - ((s - 1) / segments) * tailLen);
                if (segEndT <= 0 && segStartT <= 0) continue;

                const sx = Phaser.Math.Linear(e.x1, e.x2, segStartT);
                const sy = Phaser.Math.Linear(e.y1, e.y2, segStartT);
                const ex = Phaser.Math.Linear(e.x1, e.x2, segEndT);
                const ey = Phaser.Math.Linear(e.y1, e.y2, segEndT);

                const t = 1 - s / segments;
                const lineWidth = 0.3 + t * 2.2; 
                const segAlpha = lifeAlpha * t * 0.8;

                g.lineStyle(lineWidth, pulse.color, segAlpha);
                g.beginPath();
                g.moveTo(sx, sy);
                g.lineTo(ex, ey);
                g.strokePath();
            }
        }
    }

    private createGlowTexture() {
        if (this.textures.exists('soft_glow')) return;
        const radius = 64;
        const canvas = document.createElement('canvas');
        canvas.width = radius * 2;
        canvas.height = radius * 2;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
        const grd = ctx.createRadialGradient(radius, radius, 0, radius, radius, radius);
        grd.addColorStop(0, 'rgba(255, 255, 255, 1)');
        grd.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
        grd.addColorStop(0.5, 'rgba(255, 255, 255, 0.3)');
        grd.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = grd;
        ctx.fillRect(0, 0, radius * 2, radius * 2);
        this.textures.addCanvas('soft_glow', canvas);
    }

    private createStarfieldBackground() {
        const RANGE = 2400;
        this.createNebulaGlowTexture();

        this.bgStarFar = this.add.graphics().setDepth(-10);
        for (let i = 0; i < 400; i++) {
            const x = (Math.random() - 0.5) * RANGE * 2;
            const y = (Math.random() - 0.5) * RANGE * 2;
            const alpha = 0.2 + Math.random() * 0.35;
            const c = Math.random();
            let color = 0xffffff;
            if (c > 0.92) color = 0xbfd4ff;
            else if (c > 0.85) color = 0xffe8c4;
            this.bgStarFar.fillStyle(color, alpha);
            this.bgStarFar.fillCircle(x, y, 0.6 + Math.random() * 0.5);
        }

        const FACTION_BLUE   = 0x3b82f6;  
        const FACTION_RED    = 0xf87171;  
        const FACTION_GOLD   = 0xf59e0b;  
        const FACTION_PINK   = 0xfca5a5;  
        const FACTION_SKY    = 0x93c5fd;  

        const nebulaConfigs: { x: number; y: number; r: number; color: number; alpha: number; sx?: number; sy?: number; rot?: number }[] = [
            { x: -2200, y:  100, r: 900, color: FACTION_BLUE, alpha: 0.26, sx: 1.1, sy: 0.75, rot: -0.3 },
            { x: -2100, y:  200, r: 600, color: FACTION_BLUE, alpha: 0.22, sx: 0.7, sy: 1.2, rot:  0.6 },
            { x: -2350, y:   50, r: 500, color: FACTION_SKY,  alpha: 0.18, sx: 1.3, sy: 0.65, rot:  0.1 },
            { x: -1400, y:  150, r: 800, color: FACTION_BLUE, alpha: 0.22, sx: 0.85, sy: 1.15, rot: -0.4 },
            { x: -1550, y:  300, r: 550, color: FACTION_BLUE, alpha: 0.18, sx: 1.25, sy: 0.7,  rot:  0.35 },
            { x: -1150, y:  850, r: 750, color: FACTION_BLUE, alpha: 0.20, sx: 0.9,  sy: 1.05, rot: -0.15 },
            { x: -1300, y: 1000, r: 500, color: FACTION_SKY,  alpha: 0.14, sx: 1.4,  sy: 0.55, rot:  0.5 },
            { x: -1850, y:  700, r: 650, color: FACTION_BLUE, alpha: 0.18, sx: 0.75, sy: 1.3,  rot:  0.2 },
            { x: -2050, y:  950, r: 450, color: FACTION_SKY,  alpha: 0.14, sx: 1.15, sy: 0.85, rot: -0.55 },
            { x:  1700, y:  480, r: 800, color: FACTION_RED,   alpha: 0.20, sx: 1.0,  sy: 0.8,  rot: -0.2 },
            { x:  1820, y:  550, r: 550, color: FACTION_PINK,  alpha: 0.16, sx: 0.7,  sy: 1.25, rot:  0.45 },
            { x:  1580, y:  380, r: 450, color: FACTION_PINK,  alpha: 0.13, sx: 1.35, sy: 0.6,  rot: -0.38 },
            { x:  1100, y:  520, r: 750, color: FACTION_RED,   alpha: 0.17, sx: 0.88, sy: 1.12, rot:  0.15 },
            { x:  1280, y:  650, r: 500, color: FACTION_PINK,  alpha: 0.13, sx: 1.2,  sy: 0.72, rot: -0.28 },
            { x:   950, y:  400, r: 450, color: FACTION_RED,   alpha: 0.14, sx: 0.68, sy: 1.35, rot:  0.52 },
            { x:  1250, y:    0, r: 600, color: FACTION_RED,   alpha: 0.16, sx: 1.08, sy: 0.78, rot: -0.12 },
            { x:  1480, y:  100, r: 420, color: FACTION_PINK,  alpha: 0.12, sx: 0.78, sy: 1.18, rot:  0.33 },
            { x:  1750, y:   10, r: 350, color: FACTION_PINK,  alpha: 0.11, sx: 1.42, sy: 0.58, rot: -0.45 },
            { x:  1750, y:  950, r: 550, color: FACTION_RED,   alpha: 0.15, sx: 0.92, sy: 1.06, rot:  0.08 },
            { x:  1450, y: 1050, r: 400, color: FACTION_PINK,  alpha: 0.12, sx: 1.22, sy: 0.66, rot: -0.42 },
            { x:  -150, y:  840, r: 700, color: FACTION_GOLD, alpha: 0.24, sx: 0.95, sy: 1.08, rot: -0.18 },
            { x:   -80, y:  960, r: 480, color: FACTION_GOLD, alpha: 0.18, sx: 1.28, sy: 0.68, rot:  0.36 },
            { x:   220, y: 1000, r: 420, color: FACTION_GOLD, alpha: 0.15, sx: 0.74, sy: 1.22, rot: -0.26 },
            { x:     0, y:    0, r: 480, color: FACTION_PINK,  alpha: 0.12, sx: 1.05, sy: 0.85, rot:  0.1 },
        ];

        nebulaConfigs.forEach(n => {
            const img = this.add.image(n.x, n.y, 'nebula_glow')
