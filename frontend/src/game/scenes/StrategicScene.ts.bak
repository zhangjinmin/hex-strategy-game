            const x = (Math.random() - 0.5) * RANGE * 2;
            const y = (Math.random() - 0.5) * RANGE * 2;
            const alpha = 0.45 + Math.random() * 0.35;
            this.add.image(x, y, 'soft_glow')
                .setDepth(-1)
                .setBlendMode(Phaser.BlendModes.ADD)
                .setDisplaySize(8 + Math.random() * 8, 8 + Math.random() * 8)
                .setAlpha(alpha * 0.55);
            this.bgStarNear.fillStyle(0xffffff, alpha);
            this.bgStarNear.fillCircle(x, y, 1.0 + Math.random() * 0.7);
        }
    }

    private createNebulaGlowTexture() {
        if (this.textures.exists('nebula_glow')) return;
        const size = 256;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
        const grd = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        grd.addColorStop(0,    'rgba(255, 255, 255, 0.85)');
        grd.addColorStop(0.15, 'rgba(255, 255, 255, 0.55)');
        grd.addColorStop(0.35, 'rgba(255, 255, 255, 0.28)');
        grd.addColorStop(0.6,  'rgba(255, 255, 255, 0.10)');
        grd.addColorStop(0.85, 'rgba(255, 255, 255, 0.03)');
        grd.addColorStop(1,    'rgba(255, 255, 255, 0)');
        ctx.fillStyle = grd;
        ctx.fillRect(0, 0, size, size);
        this.textures.addCanvas('nebula_glow', canvas);
    }

    private getOrCreatePlanetTexture(node: any): string {
        const customKey = `planet_${node.id}`;
        if (customPlanetIds.includes(node.id) && this.textures.exists(customKey)) {
            return customKey;
        }

        const procKey = `proc_planet_${node.id}`;
        if (this.textures.exists(procKey)) return procKey; 

        const isCap = node.type === 'capital' || node.type === 'fortress';
        const baseRadius = isCap ? 28 : 20;
        const PADDING = baseRadius * 0.3; 
        const size = baseRadius * 2 + PADDING * 2; 
        const radius = baseRadius; 
        const canvas = document.createElement('canvas');
        const SS = 2;
        canvas.width = Math.ceil(size * SS);
        canvas.height = Math.ceil(size * SS);
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
        ctx.scale(SS, SS);
        ctx.translate(PADDING, PADDING); 

        let seed = node.id * 997 + node.ownerFactionId * 31337 + 42;
        const rand = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };

        type PlanetType = 'terrestrial' | 'gas' | 'desert' | 'ice' | 'ocean' | 'lava' | 'rocky';
        const planetTypes: PlanetType[] = ['terrestrial', 'gas', 'desert', 'ice', 'ocean', 'lava', 'rocky'];
        const typeIndex = Math.abs((node.id * 7919 + node.ownerFactionId * 3571)) % planetTypes.length;
        const planetType = planetTypes[typeIndex];

        const isEarthWasteland = (node.id === 99);

        const PALETTES: Record<PlanetType, { main: string; secondary: string; highlight: string; atmosphere: string; bands?: boolean }> = {
            terrestrial: { main: '#2d5a3d', secondary: '#1e4d6b', highlight: '#7fb069', atmosphere: 'rgba(120, 180, 220, 0.6)', bands: false },
            gas: { main: '#c8956b', secondary: '#8b5a2b', highlight: '#e8c39e', atmosphere: 'rgba(220, 180, 140, 0.5)', bands: true },
            desert: { main: '#b5563a', secondary: '#7a3520', highlight: '#d97757', atmosphere: 'rgba(200, 100, 60, 0.4)', bands: false },
            ice: { main: '#5ab3c4', secondary: '#2a7a8a', highlight: '#a8e6ed', atmosphere: 'rgba(150, 220, 240, 0.55)', bands: false },
            ocean: { main: '#1e5b8c', secondary: '#0d3a5c', highlight: '#4a9bc7', atmosphere: 'rgba(80, 160, 220, 0.6)', bands: false },
            lava: { main: '#3d1810', secondary: '#7a2810', highlight: '#ff6b2b', atmosphere: 'rgba(255, 100, 40, 0.45)', bands: false },
            rocky: { main: '#6b6b6b', secondary: '#4a4a4a', highlight: '#9a9a9a', atmosphere: 'rgba(180, 180, 180, 0.3)', bands: false },
        };

        const WASTELAND_PALETTE = {
            main: '#4a3f35', secondary: '#2d2620', highlight: '#6b5d4d', atmosphere: 'rgba(120, 90, 60, 0.25)', bands: false
        };

        let palette = isEarthWasteland ? WASTELAND_PALETTE : PALETTES[planetType];

        let factionTint = '';
        if (node.ownerFactionId === 1) factionTint = 'rgba(40, 80, 180, 0.08)';
        else if (node.ownerFactionId === 2) factionTint = 'rgba(180, 40, 40, 0.08)';
        else if (node.ownerFactionId === 0) factionTint = 'rgba(200, 150, 30, 0.08)';

        const lightX = radius * 0.65;
        const lightY = radius * 0.65;
        const baseGrad = ctx.createRadialGradient(lightX, lightY, 0, lightX, lightY, radius * 1.4);
        baseGrad.addColorStop(0, palette.highlight);
        baseGrad.addColorStop(0.35, palette.main);
        baseGrad.addColorStop(0.75, palette.secondary);
        baseGrad.addColorStop(1, '#000000');

        ctx.save();
        ctx.beginPath();
        ctx.arc(radius, radius, radius, 0, Math.PI * 2);
        ctx.clip();
        ctx.fillStyle = baseGrad;
        ctx.fillRect(0, 0, size, size);

        if (palette.bands) {
            const numBands = 5 + Math.floor(rand() * 4);
            for (let i = 0; i < numBands; i++) {
                const bandY = (i / numBands) * size + (rand() - 0.5) * 4;
                const bandH = (radius * 2 / numBands) * (0.6 + rand() * 0.5);
                const bandAlpha = 0.15 + rand() * 0.25;
                const bandColor = rand() > 0.5 ? palette.secondary : (rand() > 0.5 ? palette.highlight : palette.main);
                ctx.fillStyle = this.hexToRgba(bandColor, bandAlpha);
                ctx.beginPath();
                ctx.moveTo(0, bandY);
                for (let x = 0; x <= size; x += 3) {
                    const wave = Math.sin((x / size) * Math.PI * 3 + i * 1.7) * 1.5;
                    ctx.lineTo(x, bandY + wave);
                }
                ctx.lineTo(size, bandY + bandH);
                for (let x = size; x >= 0; x -= 3) {
                    const wave = Math.sin((x / size) * Math.PI * 3 + i * 1.7 + 0.5) * 1.5;
                    ctx.lineTo(x, bandY + bandH + wave);
                }
                ctx.closePath();
                ctx.fill();
            }
            if (rand() > 0.6) {
                const sx = radius * (0.5 + rand() * 0.8);
                const sy = radius * (0.7 + rand() * 0.6);
                const sr = radius * (0.15 + rand() * 0.15);
                const stormGrad = ctx.createRadialGradient(sx, sy, 0, sx, sy, sr);
                stormGrad.addColorStop(0, this.hexToRgba(palette.secondary, 0.7));
                stormGrad.addColorStop(1, this.hexToRgba(palette.secondary, 0));
                ctx.fillStyle = stormGrad;
                ctx.beginPath();
                ctx.ellipse(sx, sy, sr * 1.3, sr * 0.7, rand() * Math.PI, 0, Math.PI * 2);
                ctx.fill();
            }
        } else {
            const numContinents = 2 + Math.floor(rand() * 4);
            for (let i = 0; i < numContinents; i++) {
                const cx = radius + (rand() - 0.5) * radius * 1.5;
                const cy = radius + (rand() - 0.5) * radius * 1.5;
                const cw = radius * (0.25 + rand() * 0.4);
                const ch = radius * (0.2 + rand() * 0.35);
                const rot = rand() * Math.PI;
                const contAlpha = 0.35 + rand() * 0.35;
                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(rot);
                const contGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, Math.max(cw, ch));
                contGrad.addColorStop(0, this.hexToRgba(palette.highlight, contAlpha));
                contGrad.addColorStop(0.6, this.hexToRgba(palette.highlight, contAlpha * 0.5));
                contGrad.addColorStop(1, this.hexToRgba(palette.highlight, 0));
                ctx.fillStyle = contGrad;
                ctx.beginPath();
                ctx.ellipse(0, 0, cw, ch, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            const numDetails = 4 + Math.floor(rand() * 6);
            for (let i = 0; i < numDetails; i++) {
                const cx = radius + (rand() - 0.5) * radius * 1.4;
                const cy = radius + (rand() - 0.5) * radius * 1.4;
                const cr = radius * (0.05 + rand() * 0.15);
                const isLight = rand() > 0.5;
                const detailColor = isLight ? palette.highlight : palette.secondary;
                ctx.fillStyle = this.hexToRgba(detailColor, 0.2 + rand() * 0.3);
                ctx.beginPath();
                ctx.arc(cx, cy, cr, 0, Math.PI * 2);
                ctx.fill();
            }

            if (planetType === 'lava') {
                const numCracks = 2 + Math.floor(rand() * 3);
                for (let i = 0; i < numCracks; i++) {
                    ctx.strokeStyle = this.hexToRgba(palette.highlight, 0.6 + rand() * 0.3);
                    ctx.lineWidth = 0.8 + rand() * 0.8;
                    ctx.beginPath();
                    let cx = radius + (rand() - 0.5) * radius * 1.2;
                    let cy = radius + (rand() - 0.5) * radius * 1.2;
                    ctx.moveTo(cx, cy);
                    const segs = 3 + Math.floor(rand() * 3);
                    for (let j = 0; j < segs; j++) {
                        cx += (rand() - 0.5) * radius * 0.5;
                        cy += (rand() - 0.5) * radius * 0.5;
                        ctx.lineTo(cx, cy);
                    }
                    ctx.stroke();
                }
            }

            if (planetType === 'ice' || planetType === 'ocean' || planetType === 'terrestrial') {
                if (rand() > 0.4) {
                    const polarGrad = ctx.createRadialGradient(radius, radius * 0.2, 0, radius, radius * 0.2, radius * 0.5);
                    polarGrad.addColorStop(0, 'rgba(255, 255, 255, 0.7)');
                    polarGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                    ctx.fillStyle = polarGrad;
                    ctx.beginPath();
                    ctx.ellipse(radius, radius * 0.2, radius * 0.7, radius * 0.3, 0, 0, Math.PI * 2);
                    ctx.fill();
                    
                    const polarGrad2 = ctx.createRadialGradient(radius, radius * 1.8, 0, radius, radius * 1.8, radius * 0.5);
                    polarGrad2.addColorStop(0, 'rgba(255, 255, 255, 0.6)');
                    polarGrad2.addColorStop(1, 'rgba(255, 255, 255, 0)');
                    ctx.fillStyle = polarGrad2;
                    ctx.beginPath();
                    ctx.ellipse(radius, radius * 1.8, radius * 0.7, radius * 0.3, 0, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }

        if (isEarthWasteland) {
            const dustBands = 3 + Math.floor(rand() * 2);
            for (let i = 0; i < dustBands; i++) {
                const bandY = radius * (0.2 + i * 0.25) + (rand() - 0.5) * radius * 0.15;
                const bandH = radius * (0.08 + rand() * 0.06);
                const dustGrad = ctx.createLinearGradient(0, bandY - bandH, 0, bandY + bandH);
                dustGrad.addColorStop(0, 'rgba(90, 70, 50, 0)');
                dustGrad.addColorStop(0.5, 'rgba(100, 80, 60, 0.25 + rand() * 0.15)');
                dustGrad.addColorStop(1, 'rgba(90, 70, 50, 0)');
                ctx.fillStyle = dustGrad;
                ctx.fillRect(0, bandY - bandH, size, bandH * 2);
            }

            const numRuins = 5 + Math.floor(rand() * 4);
            for (let i = 0; i < numRuins; i++) {
                const rx = radius + (rand() - 0.5) * radius * 1.4;
                const ry = radius + (rand() - 0.5) * radius * 1.4;
                const rr = radius * (0.08 + rand() * 0.12);
                const ruinGrad = ctx.createRadialGradient(rx, ry, 0, rx, ry, rr);
                ruinGrad.addColorStop(0, 'rgba(30, 22, 18, 0.45)');
                ruinGrad.addColorStop(0.7, 'rgba(40, 30, 24, 0.25)');
                ruinGrad.addColorStop(1, 'rgba(40, 30, 24, 0)');
                ctx.fillStyle = ruinGrad;
                ctx.beginPath();
                ctx.arc(rx, ry, rr, 0, Math.PI * 2);
                ctx.fill();
            }

            const deadZones = 2 + Math.floor(rand() * 2);
            for (let i = 0; i < deadZones; i++) {
                const dx = radius + (rand() - 0.5) * radius * 1.0;
                const dy = radius + (rand() - 0.5) * radius * 1.0;
                const dr = radius * (0.15 + rand() * 0.2);
                const deadGrad = ctx.createRadialGradient(dx, dy, 0, dx, dy, dr);
                deadGrad.addColorStop(0, 'rgba(60, 55, 50, 0.2)');
                deadGrad.addColorStop(1, 'rgba(60, 55, 50, 0)');
                ctx.fillStyle = deadGrad;
                ctx.beginPath();
                ctx.ellipse(dx, dy, dr * 1.2, dr * 0.8, rand() * Math.PI, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        if (factionTint) {
            ctx.fillStyle = factionTint;
            ctx.fillRect(0, 0, size, size);
        }

        const shadowGrad = ctx.createRadialGradient(radius * 1.35, radius * 1.35, 0, radius * 1.35, radius * 1.35, radius * 1.2);
        shadowGrad.addColorStop(0, 'rgba(0, 0, 0, 0.55)');
        shadowGrad.addColorStop(0.5, 'rgba(0, 0, 0, 0.25)');
        shadowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = shadowGrad;
        ctx.fillRect(0, 0, size, size);

        ctx.restore();

        const atmoGrad = ctx.createRadialGradient(radius, radius, radius * 0.85, radius, radius, radius * 1.15);
        atmoGrad.addColorStop(0, 'rgba(255, 255, 255, 0)');
        atmoGrad.addColorStop(0.5, palette.atmosphere);
        atmoGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = atmoGrad;
        ctx.beginPath();
        ctx.arc(radius, radius, radius * 1.15, 0, Math.PI * 2);
        ctx.fill();

        const specGrad = ctx.createRadialGradient(radius * 0.6, radius * 0.6, 0, radius * 0.6, radius * 0.6, radius * 0.35);
        specGrad.addColorStop(0, 'rgba(255, 255, 255, 0.45)');
        specGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.12)');
        specGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = specGrad;
        ctx.beginPath();
        ctx.arc(radius, radius, radius, 0, Math.PI * 2);
        ctx.clip();
        ctx.fillRect(0, 0, size, size);

        this.textures.addCanvas(procKey, canvas);
        return procKey;
    }

    private hexToRgba(hex: string, alpha: number): string {
        const h = hex.replace('#', '');
        const r = parseInt(h.substring(0, 2), 16);
        const g = parseInt(h.substring(2, 4), 16);
        const b = parseInt(h.substring(4, 6), 16);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    private renderStaticTopology() {
        this.edgeGraphics.clear();
        this.edgeFlowGraphics.clear();
        this.edges = [];
        this.edgeNextPulseTimes = [];
        this.activePulses = [];
        this.nodeGraphicsMap.clear();

        this.constellationContainers.forEach(c => c.destroy());
        this.constellationContainers = [];

        const rawNodes = this.store.strategicNodes;
        const nodes = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
        const now = this.time.now;

        const drawnEdges = new Set<string>();
        nodes.forEach((node: any) => {
            (node.connections || []).forEach((targetId: number) => {
                const edgeKey = [node.id, targetId].sort().join('-');
                if (!drawnEdges.has(edgeKey)) {
                    drawnEdges.add(edgeKey);
                    const targetNode = nodes.find((n: any) => n.id === targetId);
                    if (targetNode) {
                        let factionHint = -1;
                        if (node.ownerFactionId === targetNode.ownerFactionId) {
                            factionHint = node.ownerFactionId;
                        }
                        const idx = this.edges.length;
                        this.edges.push({
                            x1: node.x, y1: node.y,
                            x2: targetNode.x, y2: targetNode.y,
                            length: Phaser.Math.Distance.Between(node.x, node.y, targetNode.x, targetNode.y),
                            factionHint
                        });

                        this.edgeNextPulseTimes.push(now + idx * 600 + Math.random() * 3000);

                        const line = new Phaser.Geom.Line(node.x, node.y, targetNode.x, targetNode.y);
                        this.edgeGraphics.lineStyle(0.6, 0x334155, 0.2);
                        this.edgeGraphics.strokeLineShape(line);
                    }
                }
            });
        });

        nodes.forEach((node: any) => {
            let color = 0x94a3b8;
            let lightColor = 0xffffff;
            if (node.ownerFactionId === 1) { color = 0x3b82f6; lightColor = 0x93c5fd; }
            else if (node.ownerFactionId === 2) { color = 0xef4444; lightColor = 0xfca5a5; }
            else if (node.ownerFactionId === 0) { color = 0xf59e0b; lightColor = 0xfde047; }

            const isEarth = (node.id === 99);
            if (isEarth) {
                color = 0x5a4a3a;      
                lightColor = 0x8a7a6a; 
            }

            const hasCustomImage = customPlanetIds.includes(node.id);
            const isCapitalOrFort = node.type === 'capital' || node.type === 'fortress';
            // 基础半径：有图片=45，首都/要塞=28，普通=20
            let planetRadius = node.type === 'empty' ? 6 : (hasCustomImage ? 45 : (isCapitalOrFort ? 28 : 20));
            // 非图片星球：基于 node.id 的稳定伪随机大小变化（±4px），增加视觉多样性
            if (!hasCustomImage && node.type !== 'empty') {
                const seed = (node.id * 2654435761) >>> 0; // Knuth 乘法哈希
                const variation = ((seed % 9) - 4) * 0.9;  // -3.6 ~ +3.6，乘以0.9避免极端
                planetRadius += variation;
            }

            // --- 领土归属指示（极淡的圆环，不喧宾夺主）---
            if (node.type !== 'empty') {
                const ringRadius = (hasCustomImage ? planetRadius : planetRadius * 1.3) + 12;
                const territoryRing = this.add.circle(node.x, node.y, ringRadius)
                    .setDepth(2.5)
                    .setStrokeStyle(0, this.getFactionColor(node.ownerFactionId), 0.2);
                this.nodeGraphicsMap.set(node.id, territoryRing);
            }

            if (node.type !== 'empty') {
                const earthNebulaAlpha = isEarth ? 0.22 : 0.2;  
                const earthGlowAlpha = isEarth ? 0.55 : 0.6;    
                const earthGlowScale = isEarth ? planetRadius * 3.8 : planetRadius * 4; 

                this.add.image(node.x, node.y, 'soft_glow')
                    .setDepth(0)
                    .setTint(color)
                    .setBlendMode(Phaser.BlendModes.ADD)
                    .setDisplaySize(planetRadius * 12, planetRadius * 12)
                    .setAlpha(earthNebulaAlpha);

                const planetGlow = this.add.image(node.x, node.y, 'soft_glow')
                    .setDepth(0)
                    .setTint(color)
                    .setBlendMode(Phaser.BlendModes.ADD)
                    .setDisplaySize(earthGlowScale, earthGlowScale)
                    .setAlpha(earthGlowAlpha);

                this.tweens.add({
                    targets: planetGlow,
                    scaleX: (earthGlowScale * 1.18) / 128,
                    scaleY: (earthGlowScale * 1.18) / 128,
                    alpha: isEarth ? 0.30 : 0.3,  
                    duration: isEarth ? 4000 + Math.random() * 2000 : 2000 + Math.random() * 1000,
                    yoyo: true,
                    repeat: -1,
                    ease: 'Sine.easeInOut'
                });

                if (isEarth) {
                    const atmoTextureKey = 'earth_wasteland_atmosphere';
                    if (!this.textures.exists(atmoTextureKey)) {
                        const atmoCanvas = document.createElement('canvas');
                        const atmoSize = 512;  
                        atmoCanvas.width = atmoSize;
                        atmoCanvas.height = atmoSize;
                        const aCtx = atmoCanvas.getContext('2d') as CanvasRenderingContext2D;
                        const center = atmoSize / 2;

                        const outerR = center * 0.95;
                        const outerGrad = aCtx.createRadialGradient(center, center, center * 0.2, center, center, outerR);
                        outerGrad.addColorStop(0, 'rgba(139, 90, 43, 0.20)');
                        outerGrad.addColorStop(0.5, 'rgba(120, 80, 40, 0.12)');
                        outerGrad.addColorStop(1, 'rgba(100, 70, 35, 0)');
                        aCtx.fillStyle = outerGrad;
                        aCtx.fillRect(0, 0, atmoSize, atmoSize);

                        const midR = center * 0.58;
                        const midGrad = aCtx.createRadialGradient(center, center, center * 0.25, center, center, midR);
                        midGrad.addColorStop(0, 'rgba(160, 100, 50, 0)');
                        midGrad.addColorStop(0.6, 'rgba(150, 95, 45, 0.18)');
                        midGrad.addColorStop(1, 'rgba(140, 90, 42, 0)');
                        aCtx.fillStyle = midGrad;
                        aCtx.fillRect(0, 0, atmoSize, atmoSize);

                        const innerR = center * 0.35;
                        const innerGrad = aCtx.createRadialGradient(center, center, center * 0.2, center, center, innerR);
                        innerGrad.addColorStop(0, 'rgba(180, 120, 60, 0.25)');
                        innerGrad.addColorStop(0.7, 'rgba(160, 100, 50, 0.15)');
                        innerGrad.addColorStop(1, 'rgba(140, 90, 43, 0)');
                        aCtx.fillStyle = innerGrad;
                        aCtx.fillRect(0, 0, atmoSize, atmoSize);

                        this.textures.addCanvas(atmoTextureKey, atmoCanvas);
                    }

                    const atmoDisplaySize = planetRadius * 9;
                    const atmosphereGlow = this.add.image(node.x, node.y, atmoTextureKey)
                        .setDepth(-0.8)
                        .setBlendMode(Phaser.BlendModes.ADD)
                        .setDisplaySize(atmoDisplaySize, atmoDisplaySize)
                        .setAlpha(0.9);

                    this.tweens.add({
                        targets: atmosphereGlow,
                        alpha: { from: 0.7, to: 1.0 },
                        duration: 5000 + Math.random() * 2000, 
                        yoyo: true,
                        repeat: -1,
                        ease: 'Sine.easeInOut'
                    });

                    const debrisCount = 12;
                    for (let i = 0; i < debrisCount; i++) {
                        const orbitAngle = (i / debrisCount) * Math.PI * 2 + Math.random() * 0.6;
                        const orbitDistance = planetRadius * (1.9 + Math.random() * 1.3);
                        const orbitSpeed = 30000 + Math.random() * 25000;
                        const particleSize = 2 + Math.random() * 1.5;

                        const brightness = Math.random();
                        let debrisColor: number;
                        if (brightness > 0.7) debrisColor = 0xCD853F;
                        else if (brightness > 0.3) debrisColor = 0xA0522D;
                        else debrisColor = 0x6B4423;

                        const debrisAlpha = 0.35 + Math.random() * 0.30;
                        const debrisOrbitContainer = this.add.container(node.x, node.y).setDepth(-0.6);
                        const debris = this.add.circle(
                            Math.cos(orbitAngle) * orbitDistance,
                            Math.sin(orbitAngle) * orbitDistance,
                            particleSize,
                            debrisColor,
                            debrisAlpha
                        ).setBlendMode(Phaser.BlendModes.ADD);
                        
                        debrisOrbitContainer.add(debris);

                        this.tweens.add({
                            targets: debrisOrbitContainer,
                            rotation: Math.PI * 2,
                            duration: orbitSpeed,
                            repeat: -1,
                            ease: 'Linear.None',
                            delay: Math.random() * orbitSpeed
                        });

                        this.tweens.add({
                            targets: debris,
                            alpha: { from: debrisAlpha * 0.4, to: debrisAlpha },
                            duration: 2000 + Math.random() * 2000,
                            yoyo: true,
                            repeat: -1,
                            ease: 'Sine.easeInOut'
                        });
                    }

                    const numGhostOrbits = 1 + Math.floor(Math.random() * 2);
                    for (let o = 0; o < numGhostOrbits; o++) {
                        const ghostOrbitContainer = this.add.container(node.x, node.y).setDepth(-0.9);
                        const ghostGraphics = this.add.graphics().setBlendMode(Phaser.BlendModes.ADD);
                        ghostOrbitContainer.add(ghostGraphics);

                        const orbitA = planetRadius * (2.2 + Math.random() * 0.8);
                        const orbitB = planetRadius * (1.6 + Math.random() * 0.6);

                        ghostGraphics.lineStyle(0.5, 0x8B6914, 0.08);
                        ghostGraphics.strokeEllipse(0, 0, orbitA * 2, orbitB * 2);

                        this.tweens.add({
                            targets: ghostOrbitContainer,
                            rotation: Math.PI * 2,
                            duration: 120000 + Math.random() * 60000,
                            repeat: -1,
                            ease: 'Linear.None'
                        });
                    }
                }
            }

            if (node.type !== 'empty') {
                const container = this.add.container(node.x, node.y).setDepth(2);

                if (node.hasArtemisNecklace) {
                    // ===== 阿尔泰米斯项链：12颗纯黑单点卫星 =====
                    const artemisOrbitRadius = planetRadius * 1.9;
                    const satelliteCount = 12;
                    const orbitGraphics = this.add.graphics();
                    orbitGraphics.lineStyle(0.5, 0x222233, 0.2);
                    orbitGraphics.strokeCircle(0, 0, artemisOrbitRadius);
                    container.add(orbitGraphics);

                    for (let i = 0; i < satelliteCount; i++) {
                        const angle = (i / satelliteCount) * Math.PI * 2;
                        const sx = Math.cos(angle) * artemisOrbitRadius;
                        const sy = Math.sin(angle) * artemisOrbitRadius;

                        // 纯黑单点卫星，尖锐无发光
                        const sat = this.add.circle(sx, sy, 2.8, 0x000000, 1.0);
                        container.add(sat);

                        // 淡脉动（暗→微亮→暗），不做发光扩散
                        this.tweens.add({
                            targets: sat,
                            alpha: { from: 0.50, to: 0.85 },
                            duration: 2500 + (i * 320) % 1500,
                            yoyo: true,
                            repeat: -1,
                            ease: 'Sine.easeInOut'
                        });
                    }

                    // 整体轨道缓慢逆时针旋转
                    (container as any).rotSpeed = -0.003;
                } else {
                    // ===== 普通星座环（原有逻辑）=====
                    const orbitGraphics = this.add.graphics();
                    container.add(orbitGraphics);

                    const earthConstellationAlpha = isEarth ? 0.08 : 0.3;
                    orbitGraphics.lineStyle(1, color, earthConstellationAlpha);

                    const pointsCount = isEarth ? Phaser.Math.Between(2, 3) : Phaser.Math.Between(4, 7);
                    const isCustomPlanet = customPlanetIds.includes(node.id);
                    const visualRadius = isCustomPlanet ? planetRadius : planetRadius * 1.3;
                    const orbitRadius = Math.ceil(visualRadius + (isEarth ? 20 : 30));
                    const points = [];

                    for (let i = 0; i < pointsCount; i++) {
                        const angle = (i / pointsCount) * Math.PI * 2 + Phaser.Math.FloatBetween(0, 0.5);
                        const r = orbitRadius + Phaser.Math.Between(-10, 15);
                        const px = Math.cos(angle) * r;
                        const py = Math.sin(angle) * r;
                        points.push({ x: px, y: py });

                        const starSize = isEarth ? 5 : 8;
                        const starAlpha = isEarth ? 0.3 : 1;
                        const star = this.add.image(px, py, 'soft_glow')
                            .setTint(lightColor)
                            .setBlendMode(Phaser.BlendModes.ADD)
                            .setDisplaySize(starSize, starSize)
                            .setAlpha(starAlpha);

                        container.add(star);

                        this.tweens.add({
                            targets: star,
                            alpha: { from: isEarth ? 0.05 : 0.2, to: isEarth ? 0.25 : 1 },
                            duration: isEarth ? Phaser.Math.Between(2000, 4000) : Phaser.Math.Between(500, 1500),
                            yoyo: true,
                            repeat: -1,
                            ease: 'Sine.easeInOut'
                        });
                    }

                    orbitGraphics.beginPath();
                    orbitGraphics.moveTo(points[0].x, points[0].y);
                    for (let i = 1; i < pointsCount; i++) {
                        orbitGraphics.lineTo(points[i].x, points[i].y);
                    }
                    orbitGraphics.closePath();
                    orbitGraphics.strokePath();

                    (container as any).rotSpeed = Phaser.Math.FloatBetween(-0.005, 0.005);
                }

                this.constellationContainers.push(container);
            }

            if (node.type !== 'empty') {
                const textureKey = this.getOrCreatePlanetTexture(node);
                const isProcPlanet = textureKey.startsWith('proc_planet_');
                const displaySize = isProcPlanet ? planetRadius * 2 * 1.3 : planetRadius * 2;
                
                const planetImg = this.add.image(node.x, node.y, textureKey).setDisplaySize(displaySize, displaySize).setDepth(3);
                // 点击交互：使用原点中心的圆形碰撞（origin 0.5,0.5 下本地坐标中心=0,0）
                planetImg.setInteractive(new Phaser.Geom.Circle(0, 0, displaySize/2 + 4), Phaser.Geom.Circle.Contains);
                this.nodeSprites.set(node.id, planetImg);
                this.bindNodeClick(planetImg, node);

                const rotDir = Math.random() > 0.5 ? 1 : -1;
                this.tweens.add({
                    targets: planetImg,
                    rotation: rotDir * Math.PI * 2,
                    duration: Phaser.Math.Between(120000, 240000), 
                    repeat: -1,
                    ease: 'Linear'
                });

                if (isEarth && !isProcPlanet) {
                    const overlayKey = 'earth_wasteland_overlay';
                    if (!this.textures.exists(overlayKey)) {
                        const ovCanvas = document.createElement('canvas');
                        ovCanvas.width = 256; ovCanvas.height = 256;
                        const oCtx = ovCanvas.getContext('2d') as CanvasRenderingContext2D;
                        oCtx.clearRect(0, 0, 256, 256);
                        oCtx.beginPath();
                        oCtx.arc(128, 128, 126, 0, Math.PI * 2);  
                        oCtx.clip();
                        const ovGrad = oCtx.createRadialGradient(128, 128, 0, 128, 128, 128);
                        ovGrad.addColorStop(0, 'rgba(61, 43, 31, 0.15)');   
                        ovGrad.addColorStop(0.7, 'rgba(61, 43, 31, 0.28)'); 
                        ovGrad.addColorStop(1, 'rgba(50, 35, 25, 0.35)');   
                        oCtx.fillStyle = ovGrad;
                        oCtx.fillRect(0, 0, 256, 256);
                        this.textures.addCanvas(overlayKey, ovCanvas);
                    }
                    this.add.image(node.x, node.y, overlayKey)
                        .setDisplaySize(displaySize * 0.95, displaySize * 0.95)
                        .setDepth(3.5)
                        .setBlendMode(Phaser.BlendModes.MULTIPLY);

                    const edgeKey = 'earth_wasteland_edge';
                    if (!this.textures.exists(edgeKey)) {
                        const eCanvas = document.createElement('canvas');
                        eCanvas.width = 256; eCanvas.height = 256;
                        const eCtx = eCanvas.getContext('2d') as CanvasRenderingContext2D;
                        eCtx.clearRect(0, 0, 256, 256);
                        eCtx.beginPath();
                        eCtx.arc(128, 128, 128, 0, Math.PI * 2);
                        eCtx.clip();
                        const eGrad = eCtx.createRadialGradient(128, 128, 100, 128, 128, 128);
                        eGrad.addColorStop(0, 'rgba(205, 133, 63, 0)');
                        eGrad.addColorStop(0.6, 'rgba(205, 133, 63, 0.12)'); 
                        eGrad.addColorStop(1, 'rgba(180, 120, 60, 0.06)');   
                        eCtx.fillStyle = eGrad;
                        eCtx.fillRect(0, 0, 256, 256);
                        this.textures.addCanvas(edgeKey, eCanvas);
                    }
                    const edgeGlow = this.add.image(node.x, node.y, edgeKey)
                        .setDisplaySize(displaySize * 1.2, displaySize * 1.2)
                        .setDepth(3.5)
                        .setBlendMode(Phaser.BlendModes.ADD)
                        .setAlpha(0.85);

                    this.tweens.add({
                        targets: edgeGlow,
                        alpha: { from: 0.6, to: 0.95 },
                        duration: 6000 + Math.random() * 2000,
                        yoyo: true,
                        repeat: -1,
                        ease: 'Sine.easeInOut'
                    });
                }
            } else {
                const emptyCircle = this.add.circle(node.x, node.y, 6, color, 0.5).setDepth(3);
                this.add.circle(node.x, node.y, 6, 0xffffff, 0.2).setDepth(3).setStrokeStyle(0, 0xffffff, 0.3);
                emptyCircle.setInteractive(new Phaser.Geom.Circle(0, 0, 10), Phaser.Geom.Circle.Contains);
                this.nodeSprites.set(node.id, emptyCircle as any);
                this.bindNodeClick(emptyCircle, node);
            }

            const earthLabelColor = isEarth ? '#7a6a5a' : '#e2e8f0';
            const labelText = this.add.text(node.x, node.y + planetRadius + 15, node.name, {
                fontSize: node.type === 'empty' ? '12px' : '14px',
                color: earthLabelColor,
                fontFamily: 'sans-serif',
                stroke: '#05050a',
                strokeThickness: 5
            }).setOrigin(0.5).setDepth(4);
            this.label_texts.push(labelText);
        });
    }

    // ===== 节点点击交互：选中舰队后点击目标节点 → 下达移动指令 =====
    private hitTestNodeAt(wx: number, wy: number): any | null {
        const rawNodes = this.store.strategicNodes;
        const allNodes = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
        for (const node of allNodes) {
            const d = Phaser.Math.Distance.Between(wx, wy, node.x, node.y);
            if (d < 28) return node; // 28px 命中范围，覆盖所有星球尺寸
        }
        return null;
    }

    private bindNodeClick(sprite: Phaser.GameObjects.GameObject, nodeData: any) {
        sprite.on('pointerdown', (pointer: Phaser.Input.Pointer) => {
            // 右键 → 弹出战略菜单
            if (pointer.button === 2) {
                this.showNodeRightMenu(pointer.worldX, pointer.worldY, nodeData);
                return;
            }
            // 左键 → 原有逻辑（全局点击关闭菜单已在 create 中处理）
            const selectedId = this.store.selectedFleetId;
            if (selectedId) {
                this.store.issueWarpOrder(selectedId, nodeData.id);
            } else {
                this.store.selectedNodeId = nodeData.id;
            }
        });
    }

    // ===== v3.1：右键直达面板（删除 ContextMenu 中间层）=====
    private showNodeRightMenu(wx: number, wy: number, nodeData: any) {
        const playerFac = this.store.factions?.find((f: any) => f.type === 'player');
        const playerFactionId = playerFac?.id || (this.store.playerAdmiralId >= 0 ? 1 : null);
        const isFriendly = nodeData.ownerFactionId === playerFactionId;
        if (isFriendly) {
            this.hideEnemyOpPanel();
            this.showLocalOpPanel(wx, wy, nodeData);
        } else {
            this.hideLocalOpPanel();
            this.showEnemyOpPanel(wx, wy, nodeData);
        }
    }
        this.hideContextMenu();
        this.hideLocalOpPanel();
        this.hideEnemyOpPanel();
        this.contextNodeData = nodeData;

        const playerFac = this.store.factions?.find((f: any) => f.type === 'player');
        const playerFactionId = playerFac?.id || (this.store.playerAdmiralId >= 0 ? 1 : null);
        const rawNodes = this.store.strategicNodes;
        const allNodes = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
        const nodeOwnerFaction = nodeData.ownerFactionId;
        const isFriendly = nodeOwnerFaction === playerFactionId;
        const isNeutral = nodeOwnerFaction === 0;

        const c = this.themeColors;
        const ITEM_H = 36, PAD = 12, W = 160;
        const items: { label: string; enabled: boolean; action: () => void; accent: number }[] = [];

        if (isFriendly) {
            // v3：友方节点"行政"→弹出本地操作面板
            items.push({ label: '行政', enabled: true, accent: c.accentGarrison, action: () => { this.hideContextMenu(); this.showLocalOpPanel(wx, wy, nodeData); } });
            items.push({ label: '驻守', enabled: true, accent: c.alliance, action: () => { this.hideContextMenu(); this.showFleetPanel(nodeData, 'garrison'); } });
        } else if (isNeutral) {
            // v3：中立节点"情报"→弹出敌方操作面板
            items.push({ label: '情报', enabled: true, accent: c.neutral, action: () => { this.hideContextMenu(); this.showEnemyOpPanel(wx, wy, nodeData); } });
        } else {
            // v3：敌方节点"情报"→弹出敌方操作面板
            items.push({ label: '情报', enabled: true, accent: c.neutral, action: () => { this.hideContextMenu(); this.showEnemyOpPanel(wx, wy, nodeData); } });
            const hasAdjacentFriendly = nodeData.connections?.some((connId: number) => {
                const neighbor = allNodes.find((n: any) => n.id === connId);
                return neighbor && neighbor.ownerFactionId === playerFactionId;
            });
            items.push({ label: '出击', enabled: !!hasAdjacentFriendly, accent: c.accentSortie, action: () => {
                if (!hasAdjacentFriendly) return;
                this.hideContextMenu();
                this.showFleetPanel(nodeData, 'sortie');
            }});
        }

        const H = items.length * ITEM_H + PAD * 2;
        const menu = this.add.container(wx, wy).setDepth(100);

        // 拟态风格背景面板
        const bg = this.add.graphics().setDepth(100);
        this.drawNeoPanel(bg, -W / 2, -H / 2, W, H, 10);
        menu.add(bg);

        // 顶部彩色 accent 细条
        const topAccent = items[0]?.accent || c.border;
        const accentBar = this.add.graphics().setDepth(101);
        accentBar.fillStyle(topAccent, 0.85);
        accentBar.fillRoundedRect(-W / 2, -H / 2, W, 3, { tl: 10, tr: 10, bl: 0, br: 0 });
        menu.add(accentBar);

        const textMutedStr = this.hexIntToStr(c.textMuted);
        const textStr = this.hexIntToStr(c.text);
        const textDisabledStr = this.hexIntToStr(c.textDisabled);
        const hoverStr = this.hexIntToStr(c.hoverText);

        items.forEach((item, idx) => {
            const yOff = -H / 2 + PAD + idx * ITEM_H + ITEM_H / 2;
            // 左侧 accent 色点
            const dot = this.add.rectangle(-W / 2 + 12, yOff, 3, 14, item.accent, item.enabled ? 0.9 : 0.25);
            // 文字（纯视觉，不再 setInteractive）
            const color = item.enabled ? textMutedStr : textDisabledStr;
            const txt = this.add.text(-W / 2 + 26, yOff, item.label, {
                fontSize: '13px', color, fontFamily: 'sans-serif'
            }).setOrigin(0, 0.5);
            // hover 凹陷高亮底
            const hoverBg = this.add.graphics().setAlpha(0);
            // 整行透明交互层（顶层，覆盖整行 hit area，替代 txt 的狭小点击区）
            const rowZone = this.add.graphics();
            rowZone.fillStyle(0xffffff, 0.001);
            rowZone.fillRect(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2);
            rowZone.setInteractive(
                new Phaser.Geom.Rectangle(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2),
                Phaser.Geom.Rectangle.Contains
            );
            // 加入容器顺序：dot → hoverBg → txt → rowZone（顶层交互）
            menu.add([dot, hoverBg, txt, rowZone]);

            if (item.enabled) {
                rowZone.on('pointerover', () => {
                    hoverBg.clear();
                    this.drawNeoInset(hoverBg, -W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2, 6);
                    hoverBg.setAlpha(0.9);
                    dot.setFillStyle(item.accent, 1);
                    txt.setColor(hoverStr);
                });
                rowZone.on('pointerout', () => {
                    hoverBg.clear();
                    hoverBg.setAlpha(0);
                    dot.setFillStyle(item.accent, 0.9);
                    txt.setColor(textMutedStr);
                });
                rowZone.on('pointerdown', item.action);
            }
        });

        // 菜单尺寸不随地图缩放
        menu.setScale(1 / this.cameras.main.zoom);
        this.contextMenu = menu;
    }

    private hideContextMenu() {
        if (this.contextMenu) { this.contextMenu.destroy(); this.contextMenu = null; }
    }

    // ===== v3 新增：本地操作面板（友方7项） =====
    private showLocalOpPanel(wx: number, wy: number, nodeData: any) {
        this.hideLocalOpPanel();
        this.hideEnemyOpPanel();

        const c = this.themeColors;
        const W = 260;
        const ITEM_H = 36;
        const PAD = 10;
        const HEADER_H = 34;

        // 获取玩家提督
        const allAdms = this.store.allAdmirals?.value || this.store.allAdmirals || [];
        const playerAdmId = this.store.playerAdmiralId;
        const playerAdm = allAdms.find((a: any) => a.id === playerAdmId);

        // 操作定义：色点 + 名称 + 效果 + 消耗
        const ops = [
            { op: 'special_tax',    label: '征收特别税',  effect: '+₮500 治安-5',  cost: 0,    color: 0x22c55e, costLabel: '免费' },
            { op: 'security_boost', label: '强化治安',    effect: '治安+15',       cost: 300,  color: 0xef4444, costLabel: '₮300' },
            { op: 'welfare_invest', label: '民生投资',    effect: '开发+150',      cost: 800,  color: 0x3b82f6, costLabel: '₮800' },
            { op: 'fortify_local',  label: '要塞化',      effect: '防御+50%',      cost: 4000, color: 0xef4444, costLabel: '₮4000' },
            { op: 'set_hq',         label: '设为防卫司令部', effect: '治安×3 供给×2', cost: 0,  color: 0x3b82f6, costLabel: '免费' },
            { op: 'emergency_draft',label: '紧急征召',    effect: '兵源+5% 士气-10', cost: 0,  color: 0xef4444, costLabel: '免费' },
            { op: 'intel_gather',   label: '情报搜集',    effect: '揭示相邻敌方',   cost: 200,  color: 0xfbbf24, costLabel: '₮200' },
        ];

        const totalRows = ops.length + 1; // +1 for 驻守
        const H = HEADER_H + totalRows * ITEM_H + PAD * 2;

        const panel = this.add.container(wx, wy).setDepth(110);

        // 拟态风格背景面板
        const bg = this.add.graphics().setDepth(110);
        this.drawNeoPanel(bg, -W / 2, -H / 2, W, H, 10);
        panel.add(bg);

        // 顶部 accent 条
        const accentBar = this.add.graphics().setDepth(111);
        accentBar.fillStyle(c.accentGarrison, 0.85);
        accentBar.fillRoundedRect(-W / 2, -H / 2, W, 3, { tl: 10, tr: 10, bl: 0, br: 0 });
        panel.add(accentBar);

        // 标题
        const nodeTypeLabel = nodeData.type === 'capital' ? '首都' : nodeData.type === 'fortress' ? '要塞' : nodeData.type === 'resource' ? '资源' : '星球';
        const titleTxt = this.add.text(-W / 2 + 12, -H / 2 + 8, `▎ ${nodeData.name} (友方·${nodeTypeLabel})`, {
            fontSize: '14px', color: this.hexIntToStr(c.text), fontFamily: 'sans-serif', fontStyle: 'bold'
        }).setOrigin(0, 0.5);
        panel.add(titleTxt);

        const textMutedStr = this.hexIntToStr(c.textMuted);
        const textDisabledStr = this.hexIntToStr(c.textDisabled);
        const hoverStr = this.hexIntToStr(c.hoverText);
        const metaGold = this.store.metaGold || 0;

        // 绘制每行操作
        ops.forEach((opDef, idx) => {
            const yOff = -H / 2 + HEADER_H + PAD + idx * ITEM_H + ITEM_H / 2;

            // 检查权限/冷却/国库
            const hasPerm = playerAdm ? this.adminStore?.canLocalOp(playerAdm, nodeData.id, opDef.op) : false;
            const coolingDown = this.adminStore?.isLocalOpCoolingDown(nodeData.id, opDef.op) ?? false;
            const canAfford = opDef.cost === 0 || metaGold >= opDef.cost;
            const enabled = hasPerm && !coolingDown && canAfford;

            // 左侧色点
            const dot = this.add.circle(-W / 2 + 14, yOff, 4, opDef.color, enabled ? 0.9 : 0.25);

            // 操作名称（纯视觉，不再 setInteractive）
            const nameColor = enabled ? textMutedStr : textDisabledStr;
            const nameTxt = this.add.text(-W / 2 + 26, yOff - 6, opDef.label, {
                fontSize: '13px', color: nameColor, fontFamily: 'sans-serif', fontStyle: 'bold'
            }).setOrigin(0, 0.5);

            // 效果 + 消耗
            const effectTxt = this.add.text(-W / 2 + 26, yOff + 6, `${opDef.effect}  ${opDef.costLabel}`, {
                fontSize: '11px', color: this.hexIntToStr(c.textDisabled), fontFamily: 'monospace'
            }).setOrigin(0, 0.5);

            // hover 背景
            const hoverBg = this.add.graphics().setAlpha(0);

            // 整行透明交互层（顶层，覆盖整行 hit area，替代 nameTxt 的狭小点击区）
            const rowZone = this.add.graphics();
            rowZone.fillStyle(0xffffff, 0.001);
            rowZone.fillRect(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2);
            rowZone.setInteractive(
                new Phaser.Geom.Rectangle(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2),
                Phaser.Geom.Rectangle.Contains
            );

            // 加入容器顺序：dot → nameTxt → effectTxt → hoverBg → rowZone（顶层交互）
            panel.add([dot, nameTxt, effectTxt, hoverBg, rowZone]);

            if (enabled) {
                rowZone.on('pointerover', () => {
                    hoverBg.clear();
                    this.drawNeoInset(hoverBg, -W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2, 6);
                    hoverBg.setAlpha(0.8);
                    dot.setFillStyle(opDef.color, 1);
                    nameTxt.setColor(hoverStr);
                });
                rowZone.on('pointerout', () => {
                    hoverBg.clear();
                    hoverBg.setAlpha(0);
                    dot.setFillStyle(opDef.color, 0.9);
                    nameTxt.setColor(textMutedStr);
                });
                rowZone.on('pointerdown', () => {
                    this.hideLocalOpPanel();
                    try {
                        // ≥₮2000 需二次确认
                        if (this.adminStore?.requiresConfirm(opDef.cost)) {
                            this.store.requestConfirm(
                                opDef.label,
                                `消耗${opDef.costLabel}，${opDef.effect}`,
                                opDef.cost,
                                () => {
                                    const result = this.adminStore.executeLocalOp(nodeData.id, opDef.op);
                                    this.store.triggerToast(result.message);
                                }
                            );
                        } else {
                            const result = this.adminStore.executeLocalOp(nodeData.id, opDef.op);
                            this.store.triggerToast(result.message);
                        }
                    } catch (err) {
                        console.error('[showLocalOpPanel] pointerdown error:', err);
                        this.store.triggerToast?.('操作执行失败：' + (err instanceof Error ? err.message : String(err)));
                    }
                });
            }
        });

        // 底部"驻守"行
        const garrisonYOff = -H / 2 + HEADER_H + PAD + ops.length * ITEM_H + ITEM_H / 2;
        const garrisonDot = this.add.circle(-W / 2 + 14, garrisonYOff, 4, c.alliance, 0.9);
        const garrisonTxt = this.add.text(-W / 2 + 26, garrisonYOff, '驻守（舰队编成）', {
            fontSize: '13px', color: textMutedStr, fontFamily: 'sans-serif', fontStyle: 'bold'
        }).setOrigin(0, 0.5);
        const garrisonHoverBg = this.add.graphics().setAlpha(0);
        // 整行透明交互层（顶层，覆盖整行 hit area，替代 garrisonTxt 的狭小点击区）
        const garrisonRowZone = this.add.graphics();
        garrisonRowZone.fillStyle(0xffffff, 0.001);
        garrisonRowZone.fillRect(-W / 2 + 4, garrisonYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2);
        garrisonRowZone.setInteractive(
            new Phaser.Geom.Rectangle(-W / 2 + 4, garrisonYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2),
            Phaser.Geom.Rectangle.Contains
        );
        // 加入容器顺序：garrisonDot → garrisonTxt → garrisonHoverBg → garrisonRowZone（顶层交互）
        panel.add([garrisonDot, garrisonTxt, garrisonHoverBg, garrisonRowZone]);
        garrisonRowZone.on('pointerover', () => {
            garrisonHoverBg.clear();
            this.drawNeoInset(garrisonHoverBg, -W / 2 + 4, garrisonYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2, 6);
            garrisonHoverBg.setAlpha(0.8);
            garrisonTxt.setColor(hoverStr);
        });
        garrisonRowZone.on('pointerout', () => {
            garrisonHoverBg.clear();
            garrisonHoverBg.setAlpha(0);
            garrisonTxt.setColor(textMutedStr);
        });
        garrisonRowZone.on('pointerdown', () => {
            this.hideLocalOpPanel();
            this.showFleetPanel(nodeData, 'garrison');
        });

        panel.setScale(1 / this.cameras.main.zoom);
        this.localOpPanel = panel;
    }

    private hideLocalOpPanel() {
        if (this.localOpPanel) { this.localOpPanel.destroy(); this.localOpPanel = null; }
    }

    // ===== v3 新增：敌方操作面板（敌方3项） =====
    private showEnemyOpPanel(wx: number, wy: number, nodeData: any) {
        this.hideEnemyOpPanel();
        this.hideLocalOpPanel();

        const c = this.themeColors;
        const W = 260;
        const ITEM_H = 36;
        const PAD = 10;
        const HEADER_H = 34;

        const allAdms = this.store.allAdmirals?.value || this.store.allAdmirals || [];
        const playerAdmId = this.store.playerAdmiralId;
        const playerAdm = allAdms.find((a: any) => a.id === playerAdmId);

        const ops = [
            { op: 'recon',      label: '侦察',  effect: '显示舰队数量',  cost: 200,  color: 0xfbbf24, costLabel: '₮200' },
            { op: 'infiltrate', label: '渗透',  effect: '持续可见15天',  cost: 800,  color: 0xfbbf24, costLabel: '₮800' },
            { op: 'subvert',    label: '策反',  effect: '降低守军忠诚',  cost: 1500, color: 0xef4444, costLabel: '₮1500' },
        ];

        // 检查是否敌方（有出击选项）
        const playerFac = this.store.factions?.find((f: any) => f.type === 'player');
        const playerFactionId = playerFac?.id || (this.store.playerAdmiralId >= 0 ? 1 : null);
        const isEnemy = nodeData.ownerFactionId !== playerFactionId && nodeData.ownerFactionId !== 0;

        const totalRows = ops.length + (isEnemy ? 1 : 0); // 敌方有出击
        const H = HEADER_H + totalRows * ITEM_H + PAD * 2;

        const panel = this.add.container(wx, wy).setDepth(110);

        const bg = this.add.graphics().setDepth(110);
        this.drawNeoPanel(bg, -W / 2, -H / 2, W, H, 10);
        panel.add(bg);

        const accentBar = this.add.graphics().setDepth(111);
        accentBar.fillStyle(c.neutral, 0.85);
        accentBar.fillRoundedRect(-W / 2, -H / 2, W, 3, { tl: 10, tr: 10, bl: 0, br: 0 });
        panel.add(accentBar);

        const nodeTypeLabel = nodeData.type === 'capital' ? '首都' : nodeData.type === 'fortress' ? '要塞' : nodeData.type === 'resource' ? '资源' : '星球';
        const factionLabel = isEnemy ? '敌方' : '中立';
        const titleTxt = this.add.text(-W / 2 + 12, -H / 2 + 8, `▎ ${nodeData.name} (${factionLabel}·${nodeTypeLabel})`, {
            fontSize: '14px', color: this.hexIntToStr(c.text), fontFamily: 'sans-serif', fontStyle: 'bold'
        }).setOrigin(0, 0.5);
        panel.add(titleTxt);

        const textMutedStr = this.hexIntToStr(c.textMuted);
        const textDisabledStr = this.hexIntToStr(c.textDisabled);
        const hoverStr = this.hexIntToStr(c.hoverText);
        const metaGold = this.store.metaGold || 0;

        ops.forEach((opDef, idx) => {
            const yOff = -H / 2 + HEADER_H + PAD + idx * ITEM_H + ITEM_H / 2;

            const hasPerm = playerAdm ? this.adminStore?.canEnemyOp(playerAdm, nodeData.id, opDef.op) : false;
            const coolingDown = this.adminStore?.isLocalOpCoolingDown(nodeData.id, opDef.op) ?? false;
            const canAfford = metaGold >= opDef.cost;
            const enabled = hasPerm && !coolingDown && canAfford;

            const dot = this.add.circle(-W / 2 + 14, yOff, 4, opDef.color, enabled ? 0.9 : 0.25);

            const nameColor = enabled ? textMutedStr : textDisabledStr;
            const nameTxt = this.add.text(-W / 2 + 26, yOff - 6, opDef.label, {
                fontSize: '13px', color: nameColor, fontFamily: 'sans-serif', fontStyle: 'bold'
            }).setOrigin(0, 0.5);

            const effectTxt = this.add.text(-W / 2 + 26, yOff + 6, `${opDef.effect}  ${opDef.costLabel}`, {
                fontSize: '11px', color: this.hexIntToStr(c.textDisabled), fontFamily: 'monospace'
            }).setOrigin(0, 0.5);

            const hoverBg = this.add.graphics().setAlpha(0);

            // 整行透明交互层（顶层，覆盖整行 hit area，替代 nameTxt 的狭小点击区）
            const rowZone = this.add.graphics();
            rowZone.fillStyle(0xffffff, 0.001);
            rowZone.fillRect(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2);
            rowZone.setInteractive(
                new Phaser.Geom.Rectangle(-W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2),
                Phaser.Geom.Rectangle.Contains
            );

            // 加入容器顺序：dot → nameTxt → effectTxt → hoverBg → rowZone（顶层交互）
            panel.add([dot, nameTxt, effectTxt, hoverBg, rowZone]);

            if (enabled) {
                rowZone.on('pointerover', () => {
                    hoverBg.clear();
                    this.drawNeoInset(hoverBg, -W / 2 + 4, yOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2, 6);
                    hoverBg.setAlpha(0.8);
                    dot.setFillStyle(opDef.color, 1);
                    nameTxt.setColor(hoverStr);
                });
                rowZone.on('pointerout', () => {
                    hoverBg.clear();
                    hoverBg.setAlpha(0);
                    dot.setFillStyle(opDef.color, 0.9);
                    nameTxt.setColor(textMutedStr);
                });
                rowZone.on('pointerdown', () => {
                    this.hideEnemyOpPanel();
                    try {
                        if (this.adminStore?.requiresConfirm(opDef.cost)) {
                            this.store.requestConfirm(
                                opDef.label,
                                `消耗${opDef.costLabel}，${opDef.effect}`,
                                opDef.cost,
                                () => {
                                    const result = this.adminStore.executeEnemyOp(nodeData.id, opDef.op);
                                    this.store.triggerToast(result.message);
                                }
                            );
                        } else {
                            const result = this.adminStore.executeEnemyOp(nodeData.id, opDef.op);
                            this.store.triggerToast(result.message);
                        }
                    } catch (err) {
                        console.error('[showEnemyOpPanel] pointerdown error:', err);
                        this.store.triggerToast?.('操作执行失败：' + (err instanceof Error ? err.message : String(err)));
                    }
                });
            }
        });

        // 敌方节点：底部"出击"行
        if (isEnemy) {
            const sortieYOff = -H / 2 + HEADER_H + PAD + ops.length * ITEM_H + ITEM_H / 2;
            const rawNodes = this.store.strategicNodes;
            const allNodes = rawNodes?.value !== undefined ? rawNodes.value : (rawNodes || []);
            const hasAdjacentFriendly = nodeData.connections?.some((connId: number) => {
                const neighbor = allNodes.find((n: any) => n.id === connId);
                return neighbor && neighbor.ownerFactionId === playerFactionId;
            });

            const sortieDot = this.add.circle(-W / 2 + 14, sortieYOff, 4, c.accentSortie, hasAdjacentFriendly ? 0.9 : 0.25);
            const sortieColor = hasAdjacentFriendly ? textMutedStr : textDisabledStr;
            const sortieTxt = this.add.text(-W / 2 + 26, sortieYOff, '出击（舰队编成）', {
                fontSize: '13px', color: sortieColor, fontFamily: 'sans-serif', fontStyle: 'bold'
            }).setOrigin(0, 0.5);
            const sortieHoverBg = this.add.graphics().setAlpha(0);
            // 整行透明交互层（顶层，覆盖整行 hit area，替代 sortieTxt 的狭小点击区）
            const sortieRowZone = this.add.graphics();
            sortieRowZone.fillStyle(0xffffff, 0.001);
            sortieRowZone.fillRect(-W / 2 + 4, sortieYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2);
            sortieRowZone.setInteractive(
                new Phaser.Geom.Rectangle(-W / 2 + 4, sortieYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2),
                Phaser.Geom.Rectangle.Contains
            );
            // 加入容器顺序：sortieDot → sortieTxt → sortieHoverBg → sortieRowZone（顶层交互）
            panel.add([sortieDot, sortieTxt, sortieHoverBg, sortieRowZone]);

            if (hasAdjacentFriendly) {
                sortieRowZone.on('pointerover', () => {
                    sortieHoverBg.clear();
                    this.drawNeoInset(sortieHoverBg, -W / 2 + 4, sortieYOff - ITEM_H / 2 + 1, W - 8, ITEM_H - 2, 6);
                    sortieHoverBg.setAlpha(0.8);
                    sortieTxt.setColor(hoverStr);
                });
                sortieRowZone.on('pointerout', () => {
                    sortieHoverBg.clear();
                    sortieHoverBg.setAlpha(0);
                    sortieTxt.setColor(textMutedStr);
                });
                sortieRowZone.on('pointerdown', () => {
                    this.hideEnemyOpPanel();
                    this.showFleetPanel(nodeData, 'sortie');
                });
            }
        }

        panel.setScale(1 / this.cameras.main.zoom);
        this.enemyOpPanel = panel;
    }

    private hideEnemyOpPanel() {
        if (this.enemyOpPanel) { this.enemyOpPanel.destroy(); this.enemyOpPanel = null; }
    }

    private isPointerInModal(pointer: Phaser.Input.Pointer, container: Phaser.GameObjects.Container): boolean {
        if (!container.active) return false;
        const zoom = this.cameras.main.zoom;
        // container 已经 setScale(1/zoom)，screen-space 尺寸 = 本地尺寸
        const sW = container.width * 0.5 || 80;
        const sH = container.height * 0.5 || 40;
        const cam = this.cameras.main;
        const scx = (container.x - cam.scrollX) * zoom + cam.width / 2;
        const scy = (container.y - cam.scrollY) * zoom + cam.height / 2;
        return pointer.x > scx - sW && pointer.x < scx + sW
            && pointer.y > scy - sH && pointer.y < scy + sH;
    }

    // ===== 舰队派遣面板 =====
    private showFleetPanel(nodeData: any, action: string) {
        this.hideFleetPanel();
        this.contextAction = action;

        const cam = this.cameras.main;
        const cx = cam.worldView.centerX;
        const cy = cam.worldView.centerY;

        const c = this.themeColors;
        const panel = this.add.container(cx, cy).setDepth(200);
        const isSortie = action === 'sortie';
        const title = isSortie ? '出击舰队编成' : '驻守舰队编成';
        const accentColor = isSortie ? c.accentSortie : c.accentGarrison;

        // 获取玩家所有舰队
        const allFleets = this.store.strategicFleets?.value || this.store.strategicFleets || [];
        const allAdms = this.store.allAdmirals?.value || this.store.allAdmirals || [];
        const playerAdmId = this.store.playerAdmiralId;
        const playerFac = allAdms.find((a: any) => a.id === playerAdmId)?.faction || 'alliance';
        const playerFactionId = playerFac === 'alliance' ? 1 : 2;

        const myFleets = allFleets.filter((f: any) => {
            return f.factionId === playerFactionId && f.commanderId !== playerAdmId;
        });

        const bgW = 540;
        const headerH = 72;
        const footerH = 64;
        const rowH = 32;
        const maxVisibleRows = 10;
        const visibleRows = Math.min(myFleets.length, maxVisibleRows);
        const listH = Math.max(120, visibleRows * rowH + 36);
        const bgH = headerH + listH + footerH;

        // 拟态风格主面板
        const bg = this.add.graphics().setDepth(200);
        this.drawNeoPanel(bg, -bgW / 2, -bgH / 2, bgW, bgH, 14);
        panel.add(bg);

        // 顶部 accent 彩条
        const accentBar = this.add.graphics().setDepth(201);
        accentBar.fillStyle(accentColor, 0.85);
        accentBar.fillRoundedRect(-bgW / 2, -bgH / 2, bgW, 4, { tl: 14, tr: 14, bl: 0, br: 0 });
        panel.add(accentBar);

        const titleTxt = this.add.text(-bgW / 2 + 24, -bgH / 2 + 16, title, {
            fontSize: '16px', color: this.hexIntToStr(c.text), fontFamily: 'sans-serif', fontStyle: 'bold'
        });
        const nodeName = this.store.strategicNodes?.find((n: any) => n.id === nodeData.id)?.name || '目标星域';
        const subtitle = this.add.text(-bgW / 2 + 24, -bgH / 2 + 38, `目标: ${nodeName}`, {
            fontSize: '12px', color: this.hexIntToStr(c.textMuted), fontFamily: 'sans-serif'
        });
        panel.add([titleTxt, subtitle]);

        // 列表区域（拟态凹陷）
        const listY = -bgH / 2 + headerH;
        const listBgG = this.add.graphics().setDepth(201);
        this.drawNeoInset(listBgG, -bgW / 2 + 16, listY, bgW - 32, listH, 8);
        panel.add(listBgG);

        const checkStates: Map<number, boolean> = new Map();
        let y = listY + 14;

        const headerColorStr = this.hexIntToStr(c.textDisabled);
        const nameColorStr = this.hexIntToStr(c.text);
        const posColorStr = this.hexIntToStr(c.textMuted);
        const statColorStr = this.hexIntToStr(c.textDisabled);

        if (myFleets.length === 0) {
            const emptyTxt = this.add.text(-bgW / 2 + 32, y, '暂无可用舰队', {
                fontSize: '12px', color: statColorStr, fontFamily: 'sans-serif'
            });
            panel.add(emptyTxt);
        } else {
            // 表头
            panel.add(this.add.text(-bgW / 2 + 64, y, '提督', { fontSize: '12px', color: headerColorStr, fontFamily: 'sans-serif' }).setOrigin(0, 0.5));
            panel.add(this.add.text(-bgW / 2 + 210, y, '位置', { fontSize: '12px', color: headerColorStr, fontFamily: 'sans-serif' }).setOrigin(0, 0.5));
            panel.add(this.add.text(-bgW / 2 + 380, y, '状态', { fontSize: '12px', color: headerColorStr, fontFamily: 'sans-serif' }).setOrigin(0, 0.5));
            y += 22;

            // 只渲染可见行数的舰队，避免溢出
            const visibleFleets = myFleets.slice(0, maxVisibleRows);
            visibleFleets.forEach((fleet: any) => {
                // 行级常量：捕获当前行的 Y 坐标，避免闭包引用外层可变变量 y 导致高亮位置错误
                const rowY = y;
                const adm = allAdms.find((a: any) => a.id === fleet.commanderId);
                const admName = adm?.name || '未知';
                const curNode = (this.store.strategicNodes?.value || this.store.strategicNodes || []).find((n: any) => n.id === fleet.currentNodeId);
                const curName = curNode?.name || '未知星域';
                const statusText = fleet.status === 'moving' ? `移动中` : `驻留`;

                const rowW = bgW - 40;
                const rowX = -bgW / 2 + 20;

                // 行背景（独立 graphics，文字之下，随状态重绘）
                const rowBg = this.add.graphics();

                // checkbox（纯视觉 18×18，非 interactive）
                const cb = this.add.graphics();

                const nameTxt = this.add.text(rowX + 28, rowY, admName.length > 8 ? admName.substring(0, 8) + '…' : admName, {
                    fontSize: '14px', color: nameColorStr, fontFamily: 'sans-serif'
                }).setOrigin(0, 0.5);
                const posTxt = this.add.text(rowX + 170, rowY, curName.length > 10 ? curName.substring(0, 10) + '…' : curName, {
                    fontSize: '13px', color: posColorStr, fontFamily: 'sans-serif'
                }).setOrigin(0, 0.5);
                const statTxt = this.add.text(rowX + 340, rowY, statusText, {
                    fontSize: '13px', color: statColorStr, fontFamily: 'sans-serif'
                }).setOrigin(0, 0.5);

                // 透明交互层：覆盖整行，加在所有视觉元素之后（顶层，保证可靠命中）
                const rowZone = this.add.graphics();
                rowZone.fillStyle(0xffffff, 0.001); // 几乎透明，用于撑起 hit area
                rowZone.fillRect(rowX, rowY - rowH / 2 + 1, rowW, rowH - 2);
                rowZone.setInteractive(
                    new Phaser.Geom.Rectangle(rowX, rowY - rowH / 2 + 1, rowW, rowH - 2),
                    Phaser.Geom.Rectangle.Contains
                );

                // 加入容器顺序：rowBg 最底 → cb → 文字(非 interactive) → rowZone 最顶
                panel.add([rowBg, cb, nameTxt, posTxt, statTxt, rowZone]);
                checkStates.set(fleet.id, false);

                // 统一重绘函数：根据 checked + hovering 同时重绘 rowBg 和 cb，避免状态不一致
                const redrawRow = (checked: boolean, hovering: boolean) => {
                    // —— 行背景 ——
                    rowBg.clear();
                    if (checked && hovering) {
                        // 选中 + hover：更强高亮
                        rowBg.fillStyle(accentColor, 0.32);
                        rowBg.fillRoundedRect(rowX, rowY - rowH / 2 + 1, rowW, rowH - 2, 6);
                        rowBg.fillStyle(accentColor, 1);
                        rowBg.fillRect(rowX, rowY - rowH / 2 + 1, 3, rowH - 2);
                    } else if (checked) {
                        // 选中：accent 背景 + 左侧 3px 竖条
                        rowBg.fillStyle(accentColor, 0.22);
                        rowBg.fillRoundedRect(rowX, rowY - rowH / 2 + 1, rowW, rowH - 2, 6);
                        rowBg.fillStyle(accentColor, 1);
                        rowBg.fillRect(rowX, rowY - rowH / 2 + 1, 3, rowH - 2);
                    } else if (hovering) {
                        // hover 未选：hover 色背景
                        rowBg.fillStyle(c.hover, 0.35);
                        rowBg.fillRoundedRect(rowX, rowY - rowH / 2 + 1, rowW, rowH - 2, 6);
                    }
                    // 默认：透明（clear 已处理）

                    // —— checkbox 18×18 ——
                    cb.clear();
                    if (checked) {
                        cb.fillStyle(accentColor, 1);
                        cb.fillRoundedRect(rowX - 10, rowY - 9, 18, 18, 4);
                        cb.lineStyle(2.5, 0xFFFFFF, 1);
                        cb.beginPath();
                        cb.moveTo(rowX - 6, rowY + 1);
                        cb.lineTo(rowX - 3, rowY + 4);
                        cb.lineTo(rowX + 2, rowY - 3);
                        cb.strokePath();
                    } else {
                        this.drawNeoInset(cb, rowX - 10, rowY - 9, 18, 18, 4);
                    }
                };

                // 初始绘制（未选 + 未 hover）
                redrawRow(false, false);

                // 事件绑定（仅 rowZone 一个 interactive 元素，无双触发）
                let isHovering = false;
                rowZone.on('pointerdown', () => {
                    const cur = checkStates.get(fleet.id) ?? false;
                    checkStates.set(fleet.id, !cur);
                    redrawRow(!cur, isHovering);
                });
                rowZone.on('pointerover', () => {
                    isHovering = true;
                    redrawRow(checkStates.get(fleet.id) ?? false, true);
                });
                rowZone.on('pointerout', () => {
                    isHovering = false;
                    redrawRow(checkStates.get(fleet.id) ?? false, false);
                });

                y += rowH;
            });
        }

        // 按钮区（拟态凸起按钮）
        const btnY = bgH / 2 - 28;
        const confirmBtnG = this.add.graphics().setInteractive(
            new Phaser.Geom.Rectangle(-110, btnY - 16, 100, 32),
            Phaser.Geom.Rectangle.Contains
        );
        // 确认按钮：accent 实心 + 外发光
        confirmBtnG.fillStyle(0x000000, this.isLightTheme ? 0.12 : 0.5);
        confirmBtnG.fillRoundedRect(-108, btnY - 14, 100, 32, 8);
        confirmBtnG.fillStyle(accentColor, 0.95);
        confirmBtnG.fillRoundedRect(-110, btnY - 16, 100, 32, 8);
        panel.add(confirmBtnG);
        const confirmTxt = this.add.text(-60, btnY, '确定', {
            fontSize: '13px', color: '#ffffff', fontFamily: 'sans-serif', fontStyle: 'bold'
        }).setOrigin(0.5);
        panel.add(confirmTxt);

        const cancelBtnG = this.add.graphics().setInteractive(
            new Phaser.Geom.Rectangle(10, btnY - 16, 100, 32),
            Phaser.Geom.Rectangle.Contains
        );
        // 取消按钮：拟态凸起中性
        this.drawNeoPanel(cancelBtnG, 10, btnY - 16, 100, 32, 8);
        panel.add(cancelBtnG);
        const cancelTxt = this.add.text(60, btnY, '取消', {
            fontSize: '13px', color: this.hexIntToStr(c.textMuted), fontFamily: 'sans-serif'
        }).setOrigin(0.5);
        panel.add(cancelTxt);

        // 按钮 hover 效果
        confirmBtnG.on('pointerover', () => {
            confirmBtnG.clear();
            confirmBtnG.fillStyle(0x000000, this.isLightTheme ? 0.18 : 0.6);
            confirmBtnG.fillRoundedRect(-108, btnY - 14, 100, 32, 8);
            confirmBtnG.fillStyle(accentColor, 1);
            confirmBtnG.fillRoundedRect(-110, btnY - 16, 100, 32, 8);
        });
        confirmBtnG.on('pointerout', () => {
            confirmBtnG.clear();
            confirmBtnG.fillStyle(0x000000, this.isLightTheme ? 0.12 : 0.5);
            confirmBtnG.fillRoundedRect(-108, btnY - 14, 100, 32, 8);
            confirmBtnG.fillStyle(accentColor, 0.95);
            confirmBtnG.fillRoundedRect(-110, btnY - 16, 100, 32, 8);
        });
        cancelBtnG.on('pointerover', () => {
            cancelBtnG.clear();
            cancelBtnG.fillStyle(c.hover, 0.9);
            cancelBtnG.fillRoundedRect(10, btnY - 16, 100, 32, 8);
            cancelBtnG.lineStyle(1, c.border, 0.5);
            cancelBtnG.strokeRoundedRect(10, btnY - 16, 100, 32, 8);
        });
        cancelBtnG.on('pointerout', () => {
            cancelBtnG.clear();
            this.drawNeoPanel(cancelBtnG, 10, btnY - 16, 100, 32, 8);
        });

        confirmBtnG.on('pointerdown', () => {
            const selectedIds: number[] = [];
            checkStates.forEach((v, k) => { if (v) selectedIds.push(k); });
            if (selectedIds.length === 0) {
                this.store.triggerToast?.('请至少选择一支舰队。');
                return;
            }
            let count = 0;
            selectedIds.forEach(fid => {
                this.store.issueWarpOrder(fid, nodeData.id);
                count++;
            });
            this.store.triggerToast?.(`已向 ${count} 支舰队下达${isSortie ? '出击' : '驻守'}指令。`);
            this.hideFleetPanel();
        });
        cancelBtnG.on('pointerdown', () => this.hideFleetPanel());

        // 面板尺寸不随地图缩放（update 中同步以应对 zoom 实时变化）
        panel.setScale(1 / this.cameras.main.zoom);
        this.fleetPanel = panel;
    }

    private hideFleetPanel() {
        if (this.fleetPanel) { this.fleetPanel.destroy(); this.fleetPanel = null; }
    }

    private generateStarBeltTexture() {
        const key = 'star_belt_texture';
        if (this.textures.exists(key)) return;

        const size = 2048;
        const texture = this.textures.createCanvas(key, size, size) as Phaser.Textures.CanvasTexture;
        const ctx = texture.context;

        const randomGaussian = () => {
            let u = 0, v = 0;
            while(u === 0) u = Math.random();
            while(v === 0) v = Math.random();
            return Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
        };

        for (let i = 0; i < 80000; i++) { 
            const y = Math.random() * size;
            const normalizedY = y / size; 
            
            const curveOffset = Math.sin(normalizedY * Math.PI) * 400; 
            const spineX = 600 + curveOffset; 

            const thickness = 400 + Math.sin(normalizedY * Math.PI) * 100;

            const scatterX = randomGaussian() * thickness;
            const scatterY = randomGaussian() * (thickness * 0.2); 

            const finalX = spineX + scatterX;
            const finalY = y + scatterY;

            const distFromSpine = Math.abs(scatterX) / thickness;
            const intensity = Math.max(0, 1.0 - distFromSpine); 

            const alpha = (Math.random() * 0.5 + 0.1) * (0.3 + 0.7 * intensity);
            
            let starSize = 1;
            if (intensity > 0.8 && Math.random() > 0.95) starSize = 2; 
            if (intensity > 0.95 && Math.random() > 0.99) starSize = 3; 

            ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
            ctx.fillRect(finalX, finalY, starSize, starSize);
        }
        texture.refresh();
    }
}